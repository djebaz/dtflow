      {
        "selector": "JSXOpeningElement[name.name='StatusCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|heading|glyph|minHeight|children|key|ref|className|style|children)$/]",
        "message": "<StatusCard> doesn't accept that prop. Declared props: state, heading, glyph, minHeight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:neutral|unknown|ok|warning|error)$/]",
        "message": "<StatusCard> state must be one of 'neutral' | 'unknown' | 'ok' | 'warning' | 'error'."
