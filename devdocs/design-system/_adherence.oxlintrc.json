      {
        "selector": "JSXOpeningElement[name.name='Thumbnail'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|label|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<Thumbnail> doesn't accept that prop. Declared props: src, label, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolbarRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<ToolbarRow> doesn't accept that prop. Declared props: children, style."
