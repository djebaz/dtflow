{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/data/**",
              "components/feedback/**",
              "components/gallery/**",
              "components/icons/**",
              "components/layout/**",
              "components/shell/**",
              "components/text/**",
              "ui_kits/**",
              "ui_kits/connection/**",
              "ui_kits/generate/**",
              "ui_kits/images/**",
              "ui_kits/queues/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Sans|Noto Sans Mono))/i]",
        "message": "Font not provided by the design system. Available: Noto Sans, Noto Sans Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brand'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|logo|children|key|ref|className|style|children)$/]",
        "message": "<Brand> doesn't accept that prop. Declared props: title, subtitle, logo, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|checked|disabled|onClick|children|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, checked, disabled, onClick, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|primary|danger|navigation|mode|disclosure)$/]",
        "message": "<Button> variant must be one of 'neutral' | 'primary' | 'danger' | 'navigation' | 'mode' | 'disclosure'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComboBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|invalid|disabled|value|onChange|defaultValue|className|key|ref|className|style|children)$/]",
        "message": "<ComboBox> doesn't accept that prop. Declared props: options, invalid, disabled, value, onChange, defaultValue, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|checked|disabled|children|key|ref|className|style|children)$/]",
        "message": "<ConnectionButton> doesn't accept that prop. Declared props: state, checked, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectionButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:unknown|ok|warning|error)$/]",
        "message": "<ConnectionButton> state must be one of 'unknown' | 'ok' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|selectedIndex|variant|onSelect|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, selectedIndex, variant, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|gallery)$/]",
        "message": "<DataTable> variant must be one of 'default' | 'gallery'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|logo|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, children, logo, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingToolbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:position|pill|children|key|ref|className|style|children)$/]",
        "message": "<FloatingToolbar> doesn't accept that prop. Declared props: position, pill, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingToolbar'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:top-left|top-right|bottom-right|bottom-center)$/]",
        "message": "<FloatingToolbar> position must be one of 'top-left' | 'top-right' | 'bottom-right' | 'bottom-center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|base|state|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, base, state, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:unknown|ok|warning|error)$/]",
        "message": "<Icon> state must be one of 'unknown' | 'ok' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|ratio|badge|title|subtitle|onClick|key|ref|className|style|children)$/]",
        "message": "<ImageCard> doesn't accept that prop. Declared props: src, ratio, badge, title, subtitle, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:textRole|children|className|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: textRole, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='textRole'] > Literal[value!=/^(?:body|eyebrow|caption|value|section|title|supporting|identifier|hint)$/]",
        "message": "<Label> textRole must be one of 'body' | 'eyebrow' | 'caption' | 'value' | 'section' | 'title' | 'supporting' | 'identifier' | 'hint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|minHeight|label|style|key|ref|className|style|children)$/]",
        "message": "<ListBox> doesn't accept that prop. Declared props: children, minHeight, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|children|onClick|key|ref|className|style|children)$/]",
        "message": "<ListItem> doesn't accept that prop. Declared props: selected, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoraChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|weight|status|key|ref|className|style|children)$/]",
        "message": "<LoraChip> doesn't accept that prop. Declared props: name, weight, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:menus|key|ref|className|style|children)$/]",
        "message": "<MenuBar> doesn't accept that prop. Declared props: menus."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetadataBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|children|minWidth|key|ref|className|style|children)$/]",
        "message": "<MetadataBlock> doesn't accept that prop. Declared props: icon, label, children, minWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navigation'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|onChange|connectionState|items|key|ref|className|style|children)$/]",
        "message": "<Navigation> doesn't accept that prop. Declared props: current, onChange, connectionState, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navigation'] > JSXAttribute[name.name='connectionState'] > Literal[value!=/^(?:unknown|ok|warning|error)$/]",
        "message": "<Navigation> connectionState must be one of 'unknown' | 'ok' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OverlayChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:muted|children|key|ref|className|style|children)$/]",
        "message": "<OverlayChip> doesn't accept that prop. Declared props: muted, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: eyebrow, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|label|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoundButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|onClick|key|ref|className|style|children)$/]",
        "message": "<RoundButton> doesn't accept that prop. Declared props: direction, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoundButton'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:prev|next)$/]",
        "message": "<RoundButton> direction must be one of 'prev' | 'next'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|checkable|checked|onCheckedChange|disabled|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionCard> doesn't accept that prop. Declared props: title, icon, checkable, checked, onCheckedChange, disabled, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:min|max|value|disabled|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: min, max, value, disabled, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpinBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:min|max|value|disabled|onChange|className|key|ref|className|style|children)$/]",
        "message": "<SpinBox> doesn't accept that prop. Declared props: min, max, value, disabled, onChange, className."
