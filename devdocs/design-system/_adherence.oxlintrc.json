        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|rows|placeholder|disabled|className|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: invalid, rows, placeholder, disabled, className."
