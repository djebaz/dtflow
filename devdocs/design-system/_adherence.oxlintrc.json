      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|placeholder|disabled|value|onChange|className|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: invalid, placeholder, disabled, value, onChange, className."
