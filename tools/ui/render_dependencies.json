{
  "schema_version": 1,
  "comment": "Fallback page ownership after exact component rules in render_coverage.json. First matching rule wins. Categories choose named page representative packs with a coverage-incomplete warning, not whole categories. Unknown paths use the shared pack. Globs: * stays inside one directory, ** crosses directories.",
  "rules": [
    {"why": "documentation only", "effect": "docs", "paths": ["**/*.md", "devdocs/**", "docs/**", "LICENSE*", "NOTICE*", ".github/*.md", ".github/ISSUE_TEMPLATE/**", ".github/pull_request_template.md"]},
    {"why": "CI, packaging and non-render workflows do not change screenshots", "effect": "none", "paths": [".github/workflows/ci.yml", ".github/workflows/build-and-release.yml", ".github/workflows/artifacts_swapper.yml", "tools/packaging/**", "tools/ci/**", "tools/drawthings/**", "tools/images/**", "tools/scripting/**"]},
    {"why": "tests that never feed the renderer", "effect": "none", "paths": ["tests/unit/**", "tests/integration/**", "tests/test_*.py", "tests/fixtures/tls/**"]},
    {"why": "Workflows workspace and renderer fixture", "categories": ["workflows"], "paths": ["src/dtflow/ui/workflows_*.py", "src/dtflow/ui/forms/workflows_*.ui", "src/dtflow/services/workflow_library.py", "tools/ui/render_workflows_states.py", "tools/ui/capture_workflow_preview.py", ".github/workflows/workflow-preview.yml", "src/dtflow/core/workflows.py", "src/dtflow/services/face_mask.py"]},
