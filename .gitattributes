# Normalize text files to LF by default.
* text=auto eol=lf

# Source and configuration
*.py text eol=lf
*.pyi text eol=lf
*.proto text eol=lf
*.ui text eol=lf
*.qrc text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

# Web/resource text
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.svg text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Archives / installers
*.zip binary
*.7z binary
*.exe binary
*.msi binary
*.msix binary

# ML model artifacts
*.safetensors binary
*.ckpt binary
*.pt binary
*.pth binary
*.onnx binary
*.gguf binary
