<ui version="4.0">
 <class>InpaintEditor</class>
 <widget class="QWidget" name="inpaintEditor">
  <layout class="QVBoxLayout" name="editorRootLayout">
   <item><widget class="QFrame" name="sourceCard">
    <property name="role" stdset="0"><string>card</string></property>
    <layout class="QVBoxLayout" name="sourceCardLayout">
     <item><widget class="QLabel" name="sourceTitle"><property name="text"><string>Source image</string></property><property name="textRole" stdset="0"><string>section</string></property></widget></item>
     <item><widget class="QLabel" name="sourceThumbnail"><property name="minimumSize"><size><width>80</width><height>80</height></size></property><property name="maximumSize"><size><width>240</width><height>100</height></size></property></widget></item>
     <item><widget class="QLabel" name="sourceFacts"><property name="text"><string>Choose a source image…</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
     <item><widget class="QLabel" name="sourceError"><property name="wordWrap"><bool>true</bool></property><property name="state" stdset="0"><string>error</string></property></widget></item>
     <item><widget class="QPushButton" name="chooseSourceButton"><property name="text"><string>Choose image…</string></property></widget></item>
     <item><widget class="QPushButton" name="fromImagesButton"><property name="text"><string>From Images</string></property><property name="enabled"><bool>false</bool></property><property name="toolTip"><string>In Images, select a saved image and press Edit image.</string></property></widget></item>
     <item><widget class="QPushButton" name="removeSourceButton"><property name="text"><string>Remove image</string></property></widget></item>
     <item><widget class="QLabel" name="sourceLimits"><property name="text"><string>Up to 64 MiB and 16 MP. Animated or unreadable images are rejected. Drop one image on the canvas to load it.</string></property><property name="wordWrap"><bool>true</bool></property><property name="textRole" stdset="0"><string>secondary</string></property></widget></item>
    </layout>
   </widget></item>
   <item><widget class="QFrame" name="maskCard">
    <property name="role" stdset="0"><string>card</string></property>
    <layout class="QVBoxLayout" name="maskCardLayout">
     <item><widget class="QLabel" name="maskTitle"><property name="text"><string>Mask · manual paint</string></property><property name="textRole" stdset="0"><string>section</string></property></widget></item>
     <item><widget class="QComboBox" name="toolCombo"><item><property name="text"><string>Brush</string></property></item><item><property name="text"><string>Erase</string></property></item><item><property name="text"><string>Rectangle</string></property></item><item><property name="text"><string>Circle</string></property></item></widget></item>
     <item><widget class="QSpinBox" name="brushSize"><property name="prefix"><string>Brush: </string></property><property name="suffix"><string> source px</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>512</number></property><property name="value"><number>24</number></property></widget></item>
     <item><layout class="QHBoxLayout" name="historyControls"><item><widget class="QPushButton" name="undoButton"><property name="text"><string>↶</string></property><property name="toolTip"><string>Undo (Ctrl+Z)</string></property><property name="accessibleName"><string>Undo mask edit</string></property></widget></item><item><widget class="QPushButton" name="redoButton"><property name="text"><string>↷</string></property><property name="toolTip"><string>Redo (Ctrl+Shift+Z)</string></property><property name="accessibleName"><string>Redo mask edit</string></property></widget></item></layout></item>
     <item><widget class="QComboBox" name="viewCombo"><item><property name="text"><string>Source</string></property></item><item><property name="text"><string>Mask</string></property></item><item><property name="text"><string>Result</string></property></item></widget></item>
     <item><widget class="QLabel" name="maskCaption"><property name="text"><string>Working source-grid mask. White edits; black preserves. Blue tint: 45%. Result shows the latest edit once one is available.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
     <item><widget class="QLabel" name="coverageLabel"><property name="text"><string>Covers 0% of the image</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
     <item><widget class="QPushButton" name="clearMaskButton"><property name="text"><string>Clear mask</string></property></widget></item>
     <item><widget class="QPushButton" name="loadMaskButton"><property name="text"><string>Load mask…</string></property></widget></item>
     <item><widget class="QPushButton" name="saveMaskButton"><property name="text"><string>Save mask…</string></property></widget></item>
     <item><widget class="QLabel" name="historyLabel"><property name="text"><string>No edits</string></property></widget></item>
     <item><widget class="QDoubleSpinBox" name="strengthSpinBox"><property name="toolTip"><string>1.0 replaces the masked area; lower values keep more of the source structure. Fill checkpoints worked best at 1.0 in owner probes.</string></property><property name="prefix"><string>Strength: </string></property><property name="maximum"><double>1.000000000000000</double></property><property name="singleStep"><double>0.050000000000000</double></property><property name="value"><double>0.700000000000000</double></property></widget></item>
     <item><widget class="QSpinBox" name="growSpin"><property name="toolTip"><string>Expands (positive) or shrinks (negative) the mask in source pixels before generation.</string></property><property name="prefix"><string>Grow: </string></property><property name="suffix"><string> source px</string></property><property name="minimum"><number>-64</number></property><property name="maximum"><number>64</number></property><property name="value"><number>0</number></property></widget></item>
     <item><widget class="QDoubleSpinBox" name="featherSpin"><property name="toolTip"><string>Softens the blend edge inside the mask, in source pixels.</string></property><property name="prefix"><string>Feather: </string></property><property name="suffix"><string> source px</string></property><property name="decimals"><number>1</number></property><property name="maximum"><double>64.000000000000000</double></property><property name="singleStep"><double>0.500000000000000</double></property></widget></item>
     <item><widget class="QLabel" name="sizeLabel"><property name="wordWrap"><bool>true</bool></property><property name="textRole" stdset="0"><string>secondary</string></property></widget></item>
     <item><widget class="QCheckBox" name="keepOutsideCheck"><property name="text"><string>Keep prepared pixels outside mask</string></property><property name="checked"><bool>true</bool></property></widget></item>
     <item><widget class="QLabel" name="editorCapability"><property name="text"><string>Checking whether this checkpoint can edit images…</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
     <item><widget class="QLabel" name="stepsNote"><property name="wordWrap"><bool>true</bool></property><property name="textRole" stdset="0"><string>secondary</string></property></widget></item>
     <item><widget class="QLabel" name="editorNote"><property name="text"><string>Space-drag: pan · Ctrl-wheel: zoom · Alt: reverse tool. Smart selection follows in a later slice.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
    </layout>
   </widget></item>
  </layout>
