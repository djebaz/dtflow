<property name="sizePolicy"><sizepolicy hsizetype="Fixed" vsizetype="Maximum"/></property>
<property name="minimumSize"><size><width>480</width><height>0</height></size></property>
<property name="accessibleName"><string>DT+ storage</string></property>
