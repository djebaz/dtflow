 <class>QueuePoseEditor</class>
 <widget class="QFrame" name="queuePoseEditor">
  <property name="role" stdset="0"><string>card</string></property>
  <layout class="QVBoxLayout" name="queuePoseLayout">
   <item><widget class="QLabel" name="queuePoseTitle">
