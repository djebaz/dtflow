    <item row="4" column="1"><widget class="QLineEdit" name="queuePoseToEdit">
     <property name="maximumWidth"><number>140</number></property>
     <property name="accessibleName"><string>Queue pose apply to</string></property>
     <property name="toolTip"><string>Sampling fraction up to 1; must be after Apply from.</string></property>
    </widget></item>
