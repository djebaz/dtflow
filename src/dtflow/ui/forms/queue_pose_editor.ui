     <property name="minimumSize"><size><width>0</width><height>100</height></size></property>
     <property name="maximumSize"><size><width>160</width><height>120</height></size></property>
     <property name="sizePolicy"><sizepolicy hsizetype="Ignored" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property>
     <property name="alignment"><set>Qt::AlignCenter</set></property>
     <property name="text"><string>Map preview</string></property>
     <property name="wordWrap"><bool>true</bool></property>
     <property name="textFormat"><enum>Qt::PlainText</enum></property>
     <property name="accessibleName"><string>Attached Queue pose map, read only</string></property>
    </widget></item>
    <item><widget class="QPushButton" name="replaceQueuePoseButton">
     <property name="text"><string>Replace pose map…</string></property>
     <property name="toolTip"><string>Select an already prepared body map. This changes only the Queue draft; no extraction, upload or generation occurs.</string></property>
    </widget></item>
   </layout></item>
   <item><layout class="QFormLayout" name="queuePoseFields">
    <property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property>
    <property name="rowWrapPolicy"><enum>QFormLayout::WrapLongRows</enum></property>
    <item row="0" column="0"><widget class="QLabel" name="queuePoseCheckpointLabel">
     <property name="text"><string>ControlNet checkpoint</string></property>
     <property name="buddy"><cstring>queuePoseCheckpointCombo</cstring></property>
    </widget></item>
    <item row="0" column="1"><widget class="QComboBox" name="queuePoseCheckpointCombo">
     <property name="sizePolicy"><sizepolicy hsizetype="Ignored" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property>
     <property name="accessibleName"><string>Queue ControlNet checkpoint and quantization</string></property>
     <property name="toolTip"><string>The pose guidance checkpoint, not the generation checkpoint. Choices reuse Generate's cached supported inventory; availability is rechecked when creating the queue.</string></property>
    </widget></item>
    <item row="1" column="0"><widget class="QLabel" name="queuePoseStrengthLabel">
     <property name="text"><string>Strength</string></property>
     <property name="buddy"><cstring>queuePoseStrengthEdit</cstring></property>
    </widget></item>
    <item row="1" column="1"><widget class="QLineEdit" name="queuePoseStrengthEdit">
     <property name="maximumWidth"><number>140</number></property>
     <property name="accessibleName"><string>Queue pose control strength</string></property>
     <property name="toolTip"><string>Control weight, greater than 0 and at most 2. Saved values are retained exactly, without clamping.</string></property>
    </widget></item>
    <item row="2" column="0"><widget class="QLabel" name="queuePoseModeLabel">
     <property name="text"><string>Control force</string></property>
     <property name="buddy"><cstring>queuePoseModeCombo</cstring></property>
    </widget></item>
    <item row="2" column="1"><widget class="QComboBox" name="queuePoseModeCombo">
     <property name="accessibleName"><string>Queue pose control mode</string></property>
    </widget></item>
    <item row="3" column="0"><widget class="QLabel" name="queuePoseFromLabel">
     <property name="text"><string>Apply from</string></property>
     <property name="buddy"><cstring>queuePoseFromEdit</cstring></property>
    </widget></item>
    <item row="3" column="1"><widget class="QLineEdit" name="queuePoseFromEdit">
     <property name="maximumWidth"><number>140</number></property>
     <property name="accessibleName"><string>Queue pose apply from</string></property>
     <property name="toolTip"><string>Sampling fraction from 0 to 1; must be before Apply to.</string></property>
    </widget></item>
    <item row="4" column="0"><widget class="QLabel" name="queuePoseToLabel">
