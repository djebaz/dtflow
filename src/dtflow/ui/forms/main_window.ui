                <item><widget class="QLabel" name="imageExportHint"><property name="text"><string>JPEG quality 95 with Windows-readable properties. Images go into your chosen folder; detected noise/blank can be sorted into subfolders. Originals stay untouched; JPEG is lossy and transparency becomes white.</string></property><property name="wordWrap"><bool>true</bool></property><property name="role" stdset="0"><string>secondary</string></property></widget></item>
