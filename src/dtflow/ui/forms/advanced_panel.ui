      <item row="1" column="1">
       <widget class="QCheckBox" name="hiresFixCheck">
        <property name="text"><string>Generate smaller first, then upscale to Size</string></property>
        <property name="toolTip"><string>Size stays the final output. The first pass is Size divided by the factor, rounded to 64 px. Whether DT+ honors it for a checkpoint is not checked.</string></property>
        <property name="accessibleName"><string>Hires Fix</string></property>
       </widget>
      </item>
