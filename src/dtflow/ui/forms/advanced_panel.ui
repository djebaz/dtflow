        <property name="suffix"><string> ×</string></property>
        <property name="decimals"><number>2</number></property>
        <property name="minimum"><double>1.000000000000000</double></property>
        <property name="maximum"><double>4.000000000000000</double></property>
        <property name="singleStep"><double>0.250000000000000</double></property>
        <property name="value"><double>2.000000000000000</double></property>
