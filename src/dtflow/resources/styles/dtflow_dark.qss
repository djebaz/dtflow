/* DTFlow dark Windows theme.
 * The palette and compact rhythm are adapted from the local Splitvids project;
 * selectors are DTFlow-specific and presentation state is expressed through
 * object names and dynamic properties rather than inline styles.
 */
QMainWindow,
QDialog,
QWidget {
  background-color: ${color.background};
  color: ${color.text};
  font-family: "${type.family}", sans-serif;
  font-size: ${type.body};
  font-weight: ${type.weightBody};
}
QToolTip {
  background-color: #2b2b2b;
  color: ${color.title};
  border: 1px solid ${color.borderStrong};
  padding: ${size.inputRadius};
}
QLabel {
  font-weight: ${type.weightBody};
  background: transparent;
}
QFrame#headerFrame {
  border: 1px solid ${color.panelEdge};
  border-radius: ${size.panelRadius};
}
QFrame#contextRail,
QFrame#workspaceFrame,
QFrame#inspectorPanel,
QFrame#generationContextPanel,
QFrame#generationInspector,
QFrame#queueContextPanel,
QFrame#queueWorkspace,
QFrame#queueInspector {
  background-color: ${color.surface};
  border: 1px solid ${color.panelEdge};
  border-radius: ${size.panelRadius};
}
QFrame#generationWorkspace {
  border-radius: ${size.panelRadius};
}
QFrame#headerFrame {
  background-color: #232323;
  border-color: ${color.disabledBorder};
}
QFrame#productMark {
  background-color: transparent;
  border: 0;
  border-radius: ${size.panelRadius};
}
QLabel#productMarkLabel {
  background: transparent;
  color: ${color.onAccent};
  font-size: 15pt;
  font-weight: ${type.weightStrong};
}
QLabel#productTitleLabel,
QLabel#workspaceTitleLabel,
QLabel#pageTitleLabel {
  background: transparent;
  color: ${color.title};
  font-size: ${type.title};
  font-weight: ${type.weightTitle};
}
QLabel#productSubtitleLabel,
QLabel#workspaceSubtitleLabel,
QLabel#pageSubtitleLabel,
QLabel#statusHintLabel,
QLabel#credentialStatusLabel,
QLabel[role="secondary"] {
  background: transparent;
  color: ${color.secondary};
  font-size: ${type.small};
  font-weight: ${type.weightBody};
}
QLabel:disabled,
QLabel[role="secondary"]:disabled {
  color: ${color.disabled};
}
QLabel#eyebrowLabel,
QLabel#workspaceEyebrowLabel,
QLabel#inspectorEyebrowLabel,
QLabel[role="eyebrow"] {
  background: transparent;
  color: ${color.eyebrow};
  font-size: 8pt;
  font-weight: ${type.weightStrong};
}
QLabel[role="badge"] {
  background-color: ${color.selection};
  border: 1px solid ${color.selectionBorder};
  border-radius: ${size.panelRadius};
  color: ${color.badgeText};
  font-size: 8pt;
  font-weight: ${type.weightStrong};
  padding: ${size.inputRadius} 9px;
}
QGroupBox {
  background-color: #232323;
  border: 1px solid #373737;
  border-radius: 7px;
  margin-top: 12px;
  padding-top: 8px;
  font-weight: ${type.weightEmphasis};
}
QGroupBox::title {
  font-weight: ${type.weightEmphasis};
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 ${size.inputRadius};
  color: ${color.menuText};
}
QLineEdit,
QPlainTextEdit,
QTextEdit,
QTextBrowser,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QListWidget,
QTreeWidget,
QTableView {
  background-color: ${color.input};
  border: 1px solid ${color.border};
  border-radius: ${size.inputRadius};
  color: ${color.inputText};
  selection-background-color: ${color.selection};
  selection-color: ${color.selectionText};
  alternate-background-color: ${color.toolbar};
  font-weight: ${type.weightBody};
  padding: ${size.inputRadius} 7px;
}

/* Single-line inputs keep a readable height when a page is short; the page scrolls instead of crushing them. */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
  min-height: ${size.controlContent};
}
QScrollArea[role="pageScroll"],
QWidget[role="pageScrollContents"] {
  background: transparent;
  border: 0;
}
QTextEdit:focus,
QListWidget:focus,
QTableView:focus {
  border-color: ${color.accentHover};
}
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
  background-color: ${color.surface};
  border-color: ${color.disabledBorder};
  color: ${color.disabled};
}
/* Selects reserve a distinct chevron segment while keeping the approved compact geometry. */
QComboBox {
  padding: ${size.inputRadius} 34px ${size.inputRadius} 7px;
  combobox-popup: 0;
}
QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 26px;
  margin: 0;
  border: 0;
  border-left: 1px solid ${color.border};
  border-top-right-radius: ${size.inputRadius};
  border-bottom-right-radius: ${size.inputRadius};
  background: transparent;
}
QComboBox::down-arrow {
  image: url(../images/controls/chevron-down.svg);
  width: 12px;
  height: 12px;
}
QComboBox:hover:enabled {
  background-color: ${color.surface};
}
QComboBox:hover::drop-down {
  background: transparent;
  border-left-color: ${color.inputBorderHover};
}
QComboBox:on {
  border-color: ${color.focus};
}
QComboBox:on::drop-down {
  background: transparent;
  border-left-color: ${color.focus};
}
QComboBox:disabled::drop-down {
  background: transparent;
  border-left-color: ${color.disabledBorder};
}
QComboBox QAbstractItemView {
  background-color: ${color.input};
  border: 1px solid ${color.focus};
  color: ${color.inputText};
  outline: 0;
  selection-background-color: ${color.selection};
  selection-color: ${color.selectionText};
}
QComboBox QAbstractItemView::item {
  min-height: ${size.controlContent};
  padding: 2px 8px;
}
QComboBox QAbstractItemView::item:hover {
  background-color: ${color.selectionHover};
  color: ${color.selectionText};
}
QPushButton {
  font-weight: ${type.weightLabel};
  background-color: ${color.button};
  border: 1px solid ${color.buttonBorder};
  border-radius: ${size.radius};
  color: ${color.buttonText};
  min-height: ${size.controlContent};
  padding: ${size.radius} 10px;
}
QPushButton:hover {
  background-color: ${color.buttonHover};
  border-color: ${color.buttonBorderHover};
}
QPushButton[role="navigation"] {
  background-color: transparent;
  border-color: transparent;
  color: ${color.secondary};
}
QPushButton[role="navigation"]:hover {
  background-color: ${color.button};
  border-color: ${color.border};
  color: ${color.buttonText};
}
QPushButton[role="navigation"]:checked {
  background-color: ${color.selection};
  border-color: ${color.selectionBorder};
  color: ${color.selectionText};
  font-weight: ${type.weightEmphasis};
}
QPushButton:pressed {
  background-color: ${color.buttonPressed};
  border-color: ${color.borderStrong};
}
QPushButton:disabled {
  background-color: ${color.buttonPressed};
  border-color: ${color.disabledEdge};
  color: ${color.disabled};
}
QPushButton#expandPromptButton {
  padding: 0;
}
QPushButton#expandPromptButton:checked {
  background-color: ${color.selection};
  border-color: ${color.selectionBorder};
}
QPushButton#expandPromptButton:checked:hover {
  background-color: ${color.selectionHover};
}
QPushButton#checkButton,
QPushButton#generateButton,
QPushButton#queueGenerateButton,
QPushButton[role="primary"] {
  background-color: ${color.accent};
  border-color: ${color.accent};
  color: ${color.onAccent};
  font-weight: ${type.weightEmphasis};
}
QPushButton#checkButton:hover,
QPushButton#generateButton:hover,
QPushButton#queueGenerateButton:hover,
QPushButton[role="primary"]:hover {
  background-color: ${color.accentHover};
  border-color: ${color.accentEdge};
}
/* Generate image and its Queue dropdown arrow read as one split button (#135). */
QPushButton#generateButton {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}
QPushButton#queueGenerateButton {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  border-left: 1px solid ${color.accentEdge};
  padding: 0;
  font-size: 13pt;
}
QPushButton#removeKeyButton,
QPushButton#cancelQueueButton,
QPushButton[role="danger"] {
  color: ${color.dangerText};
}
QPushButton#removeKeyButton:hover,
QPushButton#cancelQueueButton:hover,
QPushButton[role="danger"]:hover {
  background-color: ${color.dangerSurface};
  border-color: ${color.dangerBorder};
  color: ${color.onAccent};
}
QPushButton#removeKeyButton:disabled,
QPushButton#cancelQueueButton:disabled,
QPushButton[role="danger"]:disabled {
  background-color: ${color.buttonPressed};
  border-color: ${color.disabledEdge};
  color: ${color.disabled};
}
QGroupBox:disabled {
  border-color: ${color.disabledBorder};
  color: ${color.disabled};
}
QFrame#statusCard,
QFrame#queueTableHost,
QFrame#emptyStateCard,
QFrame[role="card"] {
  background-color: ${color.host};
  border: 1px solid ${color.buttonHover};
  border-radius: ${size.panelRadius};
}
QFrame#previewHost {
  border-radius: ${size.panelRadius};
}
QLabel#statusGlyphLabel {
  background: transparent;
  color: ${color.glyphNeutral};
  font-size: 18pt;
}
QFrame#statusCard[state="ok"] {
  border-color: ${color.statusOkBorder};
}
QFrame#statusCard[state="warning"] {
  border-color: ${color.statusWarningBorder};
}
QFrame#statusCard[state="error"] {
  border-color: ${color.statusErrorBorder};
}
QLabel#statusGlyphLabel[state="ok"] {
  color: ${color.success};
}
QLabel#statusGlyphLabel[state="warning"] {
  color: ${color.warning};
}
QLabel#statusGlyphLabel[state="error"] {
  color: ${color.error};
}
QLabel#statusLabel {
  background: transparent;
  color: #d7d7d7;
  font-size: 12pt;
  font-weight: ${type.weightEmphasis};
}
QLabel#statusLabel[state="ok"],
QLabel[state="ok"] {
  color: ${color.success};
}
QLabel#statusLabel[state="warning"],
QLabel[state="warning"] {
  color: ${color.warning};
}
QLabel#statusLabel[state="error"],
QLabel[state="error"] {
  color: ${color.error};
}
QLabel[state="unknown"] {
  color: ${color.unknown};
  font-size: ${type.small};
  font-weight: ${type.weightBody};
}
/* Queues header: one status chip per selected queue, and count chips that filter the items table. */
QLabel[role="statusChip"] {
  background: transparent;
  border: 1px solid ${color.borderStrong};
  border-radius: ${size.inputRadius};
  color: ${color.secondary};
  font-size: 8pt;
  font-weight: ${type.weightStrong};
  padding: 3px 9px;
}
QLabel[role="statusChip"][state="ok"] {
  border-color: ${color.statusOkBorder};
  color: ${color.success};
}
QLabel[role="statusChip"][state="warning"] {
  border-color: ${color.statusWarningBorder};
  color: ${color.warning};
}
QLabel[role="statusChip"][state="error"] {
  border-color: ${color.statusErrorBorder};
  color: ${color.error};
}
QLabel[role="statusChip"][state="secondary"] {
  background-color: ${color.selection};
  border-color: ${color.selectionBorder};
  color: ${color.badgeText};
}
QPushButton[role="filterChip"] {
  border-radius: ${size.inputRadius};
  font-size: ${type.small};
  font-weight: ${type.weightEmphasis};
  min-height: 0;
  padding: 2px 8px;
}
QPushButton[role="filterChip"][state="ok"] {
  color: ${color.success};
}
QPushButton[role="filterChip"][state="error"] {
  color: ${color.error};
}
QPushButton[role="filterChip"][state="warning"] {
  color: ${color.warning};
}
QPushButton[role="filterChip"][state="unknown"] {
  color: ${color.unknown};
}
QPushButton[role="filterChip"]:checked {
  background-color: ${color.selection};
  border-color: ${color.selectionBorder};
}
QProgressBar {
  background-color: ${color.barTrack};
  border: 1px solid ${color.border};
  border-radius: ${size.radiusSm};
  color: #e0e0e0;
  min-height: 12px;
  text-align: center;
}
QProgressBar::chunk {
  background-color: ${color.accent};
  border-radius: ${size.radiusXs};
}
QTabWidget::pane {
  border: 1px solid ${color.tabBorder};
  border-radius: ${size.radius};
  top: -1px;
}
QTabBar::tab {
  background-color: ${color.surface};
  border: 1px solid ${color.tabBorder};
  color: ${color.tabText};
  padding: 7px 12px;
}
QTabBar::tab:selected {
  background-color: ${color.button};
  border-bottom-color: ${color.button};
  color: ${color.onAccent};
}
QHeaderView::section {
  font-size: ${type.small};
  font-weight: ${type.weightLabel};
  background-color: #2b2b2b;
  border: 0;
  border-bottom: 1px solid ${color.border};
  color: #d8d8d8;
  padding: ${size.radius};
}
QSplitter::handle {
  background: transparent;
  width: 8px;
}
QSplitter::handle:hover {
  background: ${color.disabledBorder};
}
QMenuBar,
QMenu,
QStatusBar {
  background-color: ${color.background};
  color: ${color.menuText};
}
QStatusBar::item {
  border: 0;
}
QToolButton#aboutButton {
  border: 0;
  padding: 2px 6px;
}
QToolButton#aboutButton:hover {
  background-color: #343434;
}
QMenuBar::item:selected,
QMenu::item:selected {
  background-color: #343434;
}
QScrollBar:vertical {
  background: ${color.background};
  border: 0;
  margin: 0;
  width: 12px;
}
QScrollBar::handle:vertical {
  background: ${color.borderStrong};
  border-radius: ${size.inputRadius};
  min-height: 28px;
  margin: 2px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}
QPlainTextEdit[invalid="true"],
QLineEdit[invalid="true"],
QComboBox[invalid="true"],
QAbstractSpinBox[invalid="true"],
QListWidget[invalid="true"] {
  border: 1px solid ${color.error};
}
QSpinBox[level="elevated"] {
  color: #d9b36a;
}

/* One selection language: the navy of the active navigation button, for lists, tables and item views alike. */
QTableView::item:selected,
QTreeWidget::item:selected {
  background-color: ${color.selection};
  color: ${color.selectionText};
}

QGroupBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #6a6a6a;
  border-radius: ${size.radiusXs};
  background-color: ${color.input};
}
QGroupBox::indicator:hover {
  border-color: ${color.accentHover};
}
QGroupBox::indicator:checked {
  background-color: ${color.accent};
  border-color: ${color.accentEdge};
}
QGroupBox::indicator:disabled {
  border-color: ${color.border};
  background-color: ${color.surface};
}

/* Workspace states: keep the shared tokens authoritative; no per-widget inline QSS. */
QFrame#generationWorkspace,
QFrame#brandFrame,
QWidget#generationLeftRail,
QWidget#generationRightRail,
QWidget#leftRail,
QWidget#rightRail,
QWidget#centerRail,
QWidget#WorkspaceShell,
QWidget#generationBrandSlot,
QWidget#generationNavigationSlot {
  background: transparent;
  border: 0;
}
QFrame#previewHost,
ImagePreview {
  background: ${color.canvas};
  border: 1px solid ${color.buttonHover};
}
QFrame#previewToolbar,
QFrame#previewFileToolbar {
  background: ${color.toolbar};
  border: 1px solid ${color.buttonBorder};
  border-radius: ${size.radius};
}
QFrame#previewToolbar QPushButton,
QFrame#previewFileToolbar QPushButton {
  padding: 4px 7px;
  min-height: 20px;
}
QLabel#previewDesignation {
  color: ${color.text};
  background: ${color.toolbar};
  border-radius: ${size.radiusSm};
  padding: 4px 7px;
  font-size: ${type.small};
}
QPushButton:focus,
QPushButton[role="navigation"]:focus,
QCheckBox:focus {
  border: 1px solid ${color.focus};
}
QPushButton:checked {
  background: ${color.selection};
  border-color: ${color.selectionBorder};
  color: ${color.selectionText};
}
QPushButton#generateButton:pressed,
QPushButton#queueGenerateButton:pressed,
QPushButton#checkButton:pressed,
QPushButton[role="primary"]:pressed {
  background: ${color.accentPressed};
  border-color: ${color.focus};
}
QPushButton#generateButton:disabled,
QPushButton#queueGenerateButton:disabled,
QPushButton#checkButton:disabled,
QPushButton[role="primary"]:disabled {
  background: ${color.buttonPressed};
  border-color: ${color.disabledBorder};
  color: ${color.disabled};
}
QPushButton[role="navigation"] {
  min-width: 0;
  padding: 6px 8px;
}
QPushButton[role="navigation"]:checked:hover {
  background: ${color.selectionHover};
  color: ${color.selectionText};
}
QPushButton[role="navigation"]:checked:pressed {
  background: ${color.selectionPressed};
}
QLineEdit,
QPlainTextEdit,
QComboBox {
  placeholder-text-color: ${color.placeholder};
}
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
  border-color: ${color.inputBorderHover};
}
QLineEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
  border-color: ${color.focus};
}
QPlainTextEdit:disabled,
QTextBrowser:disabled,
QListWidget:disabled {
  background: ${color.surface};
  border-color: ${color.disabledBorder};
  color: ${color.disabled};
}
QListWidget::item {
  padding: 5px 6px;
}
QListWidget::item:hover {
  background: ${color.disabledBorder};
}
QListWidget::item:selected {
  background: ${color.selection};
  color: ${color.selectionText};
}
QCheckBox {
  spacing: 7px;
  background: transparent;
}
QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid ${color.checkBorder};
  border-radius: ${size.radiusXs};
  background: ${color.input};
}
QCheckBox::indicator:hover {
  border-color: ${color.focus};
}
QCheckBox::indicator:checked {
  background: ${color.accent};
  border-color: ${color.focus};
}
QCheckBox::indicator:disabled {
  background: ${color.disabledBorder};
  border-color: ${color.checkDisabledBorder};
}
QCheckBox:disabled {
  color: ${color.disabled};
}
QSlider::groove:horizontal {
  height: 4px;
  background: ${color.groove};
  border-radius: ${size.radius2xs};
}
QSlider::sub-page:horizontal {
  background: ${color.accentHover};
  border-radius: ${size.radius2xs};
}
QSlider::handle:horizontal {
  width: 12px;
  margin: -4px 0;
  background: ${color.handle};
  border: 1px solid ${color.handleBorder};
  border-radius: ${size.radiusXs};
}
QSlider::handle:horizontal:hover,
QSlider::handle:horizontal:focus {
  background: ${color.focus};
}
QSlider::handle:horizontal:pressed {
  background: ${color.accentHover};
}
QSlider::handle:horizontal:disabled {
  background: ${color.handleDisabled};
  border-color: ${color.handleDisabled};
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
  background: ${color.scrollHover};
}
QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
  background: ${color.scrollPressed};
}
ImagePreview:focus {
  border-color: ${color.focus};
}
QScrollBar:horizontal {
  background: ${color.background};
  border: 0;
  margin: 0;
  height: ${size.scrollbar};
}
QScrollBar::handle:horizontal {
  background: ${color.borderStrong};
  border-radius: ${size.inputRadius};
  min-width: 28px;
  margin: 2px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  width: 0;
  border: 0;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: transparent;
}

/* Persistent workspace gutters double as the drag targets between panels. */
QSplitter#workspaceSplitter::handle:horizontal {
  width: ${size.workspaceGutter};
  background: ${color.background};
}
QSplitter#workspaceSplitter::handle:horizontal:hover {
  background: ${color.border};
}

/* Phase 8A Detail presentation seams. Preview only; no alternate palette. */
QScrollArea[role="galleryScroll"],
QWidget[role="galleryScrollContents"] {
  background: ${color.surface};
  border: 0;
}
QFrame[role="galleryPanel"] {
  background: ${color.surface};
  border: 1px solid ${color.border};
  border-radius: ${size.radius};
}

QLabel[role="unknown"] {
  color: ${color.unknown};
  font-size: ${type.small};
  font-weight: ${type.weightBody};
}

QPlainTextEdit#galleryPositivePrompt:focus {
  border: 1px solid ${color.focus};
}

/* Permanent navigation: quiet text tabs, distinctive compact Connection control. */
QFrame#navigationFrame {
  background: transparent;
  border: 0;
}
QFrame#navigationFrame QPushButton[role="navigation"] {
  min-width: 0;
  min-height: 20px;
  padding: 6px 5px;
  background: transparent;
  border: 1px solid transparent;
  color: ${color.secondary};
  font-size: ${type.body};
}
QFrame#navigationFrame QPushButton[role="navigation"]:hover {
  background: ${color.surface};
  color: ${color.text};
}
QFrame#navigationFrame QPushButton[role="navigation"]:checked {
  background: ${color.selection};
  color: ${color.selectionText};
  border-color: ${color.border};
}
QFrame#navigationFrame QPushButton[role="navigation"]:pressed {
  background: ${color.canvas};
}
QFrame#navigationFrame QPushButton[role="navigation"]:focus {
  border-color: ${color.focus};
}
QFrame#navigationFrame QPushButton[role="navigation"]:disabled {
  background: transparent;
  border-color: transparent;
  color: ${color.disabled};
}
QPushButton#connectionNavigationButton {
  min-height: 0;
  padding: 0;
  background: ${color.input};
  border: 1px solid ${color.border};
  border-radius: ${size.panelRadius};
}
QPushButton#connectionNavigationButton:checked {
  background: ${color.selection};
}
QPushButton#connectionNavigationButton[state="ok"] {
  background: ${color.connectionSurface};
  border-color: ${color.connectionAccent};
}
QPushButton#connectionNavigationButton[state="warning"] {
  border-color: ${color.warning};
}
QPushButton#connectionNavigationButton[state="error"] {
  border-color: ${color.error};
}
QPushButton#connectionNavigationButton:hover {
  border-width: 1px;
}
QPushButton#connectionNavigationButton:pressed {
  background: ${color.canvas};
}
QPushButton#connectionNavigationButton[keyboardFocus="true"] {
  border: 1px dashed ${color.focus};
}
QPushButton#connectionNavigationButton:disabled {
  border-color: ${color.border};
  background: ${color.surface};
}
/* Define vertical page tracks too: do not inherit the native checkerboard brush. */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: ${color.background};
  border: 0;
}

/* Gallery geometry uses the shared application palette and control states. */
QWidget#GalleryDetailPage,
QWidget#galleryMainColumn {
  background: ${color.background};
  font-size: 13px;
}
QScrollArea#galleryHeaderScroll,
QWidget#galleryHeaderScrollContents,
QScrollArea#galleryFilterScroll,
QWidget#galleryFilterScrollContents {
  background: ${color.surface};
  border: 0;
  border-radius: ${size.panelRadius};
}
QWidget#GalleryDetailPage QLabel {
  font-size: 13px;
}
QWidget#GalleryDetailPage QPushButton {
  background: ${color.button};
  border: 1px solid ${color.buttonBorder};
  border-radius: ${size.radius};
  min-height: 0;
  padding: 0 8px;
  font-size: 13px;
  color: ${color.text};
}
QWidget#GalleryDetailPage QPushButton:disabled {
  color: ${color.disabled};
  background: ${color.buttonPressed};
  border-color: ${color.disabledBorder};
}
QWidget#GalleryDetailPage QPushButton:hover {
  background: ${color.buttonHover};
  border-color: ${color.buttonBorderHover};
}
QWidget#GalleryDetailPage QPushButton:pressed {
  background: ${color.buttonPressed};
  border-color: ${color.borderStrong};
}
QWidget#GalleryDetailPage QPushButton:focus {
  border-color: ${color.focus};
}
QWidget#GalleryDetailPage QPushButton[role="galleryMode"] {
  padding: 0 10px;
}
QWidget#GalleryDetailPage QPushButton[role="galleryMode"]:checked {
  background: ${color.selection};
  border-color: ${color.border};
  color: ${color.selectionText};
  font-weight: ${type.weightEmphasis};
}
QWidget#GalleryDetailPage QPushButton[role="galleryMode"]:checked:hover {
  background: ${color.selectionHover};
  color: ${color.selectionText};
}
QWidget#GalleryDetailPage QPushButton[role="galleryMode"]:checked:pressed {
  background: ${color.selectionPressed};
}
QWidget#GalleryDetailPage QPushButton[role="galleryMode"]:focus {
  border-color: ${color.focus};
}
/* Generate keeps the shared select treatment within its mounted context panel. */
QFrame#generationContextPanel QComboBox {
  background: ${color.input};
  border: 1px solid ${color.border};
  border-radius: ${size.inputRadius};
  padding: 0 10px;
  min-height: 34px;
}
QFrame#generationContextPanel QComboBox:hover {
  border-color: ${color.inputBorderHover};
}
QFrame#generationContextPanel QComboBox:focus,
QFrame#generationContextPanel QComboBox:on {
  border-color: ${color.focus};
}

/* Connection's contextRail is reparented into the shared workspace shell at runtime,
   so scope these rules to the mounted rail rather than its original connectionPage parent. */
QFrame#contextRail QComboBox {
  background: ${color.input};
  border: 1px solid ${color.border};
  border-radius: ${size.inputRadius};
  padding: 0 10px;
  min-height: 34px;
}
QFrame#contextRail QComboBox:hover {
  border-color: ${color.inputBorderHover};
}
QFrame#contextRail QComboBox:focus,
QFrame#contextRail QComboBox:on {
  border-color: ${color.focus};
}

QWidget#GalleryDetailPage QLineEdit,
QWidget#GalleryDetailPage QComboBox {
  background: ${color.input};
  border: 1px solid ${color.border};
  border-radius: ${size.inputRadius};
  padding: 0 10px;
  min-height: 34px;
  font-size: 13px;
}
QWidget#GalleryDetailPage QLineEdit:hover,
QWidget#GalleryDetailPage QComboBox:hover {
  border-color: ${color.inputBorderHover};
}
QWidget#GalleryDetailPage QLineEdit:focus,
QWidget#GalleryDetailPage QComboBox:focus {
  border-color: ${color.focus};
}
QWidget#GalleryDetailPage QLineEdit:disabled,
QWidget#GalleryDetailPage QComboBox:disabled {
  color: ${color.disabled};
  background: ${color.surface};
  border-color: ${color.disabledBorder};
}
/* Auto-refresh reuses Connection colors, without changing its labelled geometry. */
QWidget#GalleryDetailPage QPushButton#galleryAutoRefreshButton {
  background: ${color.input};
  border: 1px solid ${color.border};
  border-radius: ${size.panelRadius};
  color: ${color.secondary};
}
QWidget#GalleryDetailPage QPushButton#galleryAutoRefreshButton:hover {
  background: ${color.input};
  border-color: ${color.inputBorderHover};
}
QWidget#GalleryDetailPage QPushButton#galleryAutoRefreshButton:checked {
  background: ${color.connectionSurface};
  border-color: ${color.connectionAccent};
  color: ${color.connectionGlyph};
}
QWidget#GalleryDetailPage QPushButton#galleryAutoRefreshButton:pressed {
  background: ${color.canvas};
}
QWidget#GalleryDetailPage QPushButton#galleryAutoRefreshButton[keyboardFocus="true"] {
  border: 1px dashed ${color.focus};
}
QWidget#GalleryDetailPage QPushButton#galleryAutoRefreshButton:disabled {
  background: ${color.surface};
  border: 1px solid ${color.border};
  color: ${color.disabled};
}
QPushButton#galleryRefreshButton {
  background: ${color.surface};
  border: 0;
  border-radius: ${size.panelRadius};
}
QFrame#galleryPreviewHost,
QLabel#galleryImageSurface {
  border: 0;
  border-radius: 10px;
  background: ${color.canvas};
}
QLabel[role="galleryOverlay"] {
  background: ${color.canvas};
  border: 0;
  font-size: 14px;
  color: ${color.text};
}
QLabel#galleryFixtureOverlay {
  font-size: 11px;
  color: ${color.secondary};
}
QWidget#GalleryDetailPage QPushButton#galleryPreviousButton,
QWidget#GalleryDetailPage QPushButton#galleryNextButton {
  background: ${color.canvas};
  border: 1px solid ${color.border};
  padding: 0;
  color: ${color.text};
}
QFrame#galleryImageToolbar {
  background: ${color.surface};
  border: 1px solid ${color.border};
  border-radius: ${size.radiusPill};
}
QFrame#galleryImageToolbar QPushButton,
QFrame#galleryImageToolbar QComboBox {
  background: transparent;
  border: 0;
  min-height: 0;
  padding: 0 4px;
  color: ${color.text};
}
QFrame#galleryImageToolbar QPushButton {
  font-size: 22px;
}
QFrame#galleryImageToolbar QPushButton#galleryActualSizeButton {
  font-size: 14px;
}
QScrollArea#galleryMetadataScroll,
QWidget#galleryMetadataScrollContents,
QFrame#galleryPromptPanel,
QScrollArea#galleryAdditionalScroll,
QWidget#galleryAdditionalScrollContents {
  background: ${color.surface};
  border: 1px solid ${color.border};
  border-radius: ${size.panelRadius};
}
QFrame[role="galleryMetadataBlock"] {
  border: 0;
  border-right: 1px solid ${color.border};
  background: transparent;
}
QFrame#galleryDateBlock {
  border: 0;
}
QPlainTextEdit#galleryPositivePrompt {
  background: transparent;
  border: 0;
  padding: 0;
  font-size: 14px;
}
QWidget#GalleryDetailPage QPushButton[role="galleryDisclosure"] {
  font-size: 12px;
}
QWidget#GalleryDetailPage QPushButton[role="galleryDisclosure"]:checked {
  background: ${color.accent};
  border-color: ${color.accentHover};
  color: ${color.selectionText};
}
QScrollArea#galleryFilmstripScroll,
QWidget#galleryFilmstripScrollContents {
  background: transparent;
  border: 0;
}
QWidget#GalleryDetailPage QPushButton[role="galleryThumbnail"] {
  border: 2px solid transparent;
  padding: 0;
  border-radius: ${size.radiusThumb};
}
QWidget#GalleryDetailPage QPushButton[role="galleryThumbnail"]:checked {
  border: 3px solid ${color.accent};
}
QWidget#GalleryDetailPage QPushButton[role="galleryThumbnail"]:hover {
  border-color: ${color.accentHover};
}
QWidget#GalleryDetailPage QPushButton[role="galleryDisclosure"]:focus,
QWidget#GalleryDetailPage QPushButton[role="galleryThumbnail"]:focus {
  border-color: ${color.focus};
}
QWidget#GalleryDetailPage QPushButton#galleryPreviousButton:hover,
QWidget#GalleryDetailPage QPushButton#galleryNextButton:hover {
  background: ${color.buttonHover};
  border-color: ${color.buttonBorderHover};
}
QWidget#GalleryDetailPage QPushButton#galleryPreviousButton:pressed,
QWidget#GalleryDetailPage QPushButton#galleryNextButton:pressed {
  background: ${color.buttonPressed};
  border-color: ${color.borderStrong};
}
QWidget#GalleryDetailPage QPushButton#galleryPreviousButton:focus,
QWidget#GalleryDetailPage QPushButton#galleryNextButton:focus {
  border-color: ${color.focus};
}
QPlainTextEdit#galleryRawMetadata {
  background: ${color.canvas};
}
/* Explicit content metrics prevent QSS minimum heights overriding Designer sizes. */
QWidget#GalleryDetailPage QPushButton#galleryPreviousButton,
QWidget#GalleryDetailPage QPushButton#galleryNextButton {
  min-height: 42px;
  max-height: 42px;
  border-radius: ${size.radiusRound};
}
QLabel[role="galleryOverlay"] {
  min-height: 20px;
  padding: 6px 12px;
  border-radius: ${size.radiusChip};
}
QWidget#GalleryDetailPage QComboBox {
  min-width: 0;
}
/* The compact toolbar select keeps a bare chevron, without the segment. */
QFrame#galleryImageToolbar QComboBox::drop-down,
QFrame#galleryImageToolbar QComboBox:hover::drop-down,
QFrame#galleryImageToolbar QComboBox:on::drop-down {
  width: 16px;
  border: 0;
  background: transparent;
}

QWidget#galleryBrandSlot,
QWidget#galleryNavigationSlot,
QWidget#galleryBrandRow,
QWidget#galleryNavigationRow {
  background: transparent;
  border: 0;
}
QWidget#WorkspaceShell[galleryMode="true"] {
  background: ${color.background};
}

/* Compact gallery header follows the shared design-system density. */
QWidget#galleryHeaderScrollContents QLabel,
QWidget#galleryHeaderScrollContents QPushButton,
QWidget#galleryFilterScrollContents QLabel,
QWidget#galleryFilterScrollContents QLineEdit,
QWidget#galleryFilterScrollContents QComboBox {
  font-size: ${type.small};
}
QWidget#galleryFilterScrollContents QLineEdit,
QWidget#galleryFilterScrollContents QComboBox {
  min-height: 28px;
  padding: 0 8px;
}
QWidget#galleryHeaderScrollContents QPushButton {
  padding: 0 6px;
}
QWidget#galleryBrandSlot QLabel#productTitleLabel {
  font-size: ${type.title};
}
QWidget#galleryBrandSlot QLabel#productMarkLabel {
  font-size: 15pt;
}
QWidget#galleryHeaderScrollContents QPushButton#galleryRefreshButton {
  font-size: 14pt;
}

/* Grid and List reuse the mounted Detail header and shared application palette. */
QWidget#galleryDetailContent,
QWidget#galleryGridContent,
QWidget#galleryListContent,
QWidget#galleryGridCards,
QStackedWidget#galleryContentStack,
QScrollArea#galleryGridScroll {
  background: ${color.background};
  border: 0;
}
QFrame[role="galleryCard"] {
  background: ${color.surface};
  border: 1px solid ${color.border};
  border-radius: ${size.panelRadius};
}
QWidget#GalleryDetailPage QPushButton[role="galleryCardImage"] {
  background: ${color.canvas};
  border: 0;
  padding: 0;
  border-radius: ${size.panelRadius};
}
QLabel[role="galleryCardCaption"] {
  padding: 0 8px;
  font-size: ${type.small};
}
QFrame[role="galleryCard"] QLabel[role="secondary"] {
  padding: 0 8px;
  font-size: ${type.small};
}
QTableWidget#galleryListTable {
  background: ${color.background};
  color: ${color.text};
  border: 1px solid ${color.border};
  border-radius: ${size.panelRadius};
  padding: 0;
  font-size: ${type.small};
}
QTableWidget#galleryListTable::item {
  border: 0;
  border-bottom: 1px solid ${color.border};
  padding: 4px 8px;
}
QTableWidget#galleryListTable::item:hover {
  background: ${color.surface};
}
QTableWidget#galleryListTable::item:selected {
  background: ${color.selection};
  color: ${color.selectionText};
}
QTableWidget#galleryListTable::item:selected:hover {
  background: ${color.selectionHover};
  color: ${color.selectionText};
}
/* Grid, Detail, model-backed List checks and its tri-state header share indicator glyphs/states. */
QTableWidget#galleryListTable::indicator,
QTableWidget#galleryListTable QCheckBox::indicator,
QCheckBox#galleryCardCheck::indicator,
QCheckBox#galleryDetailSelectionCheck::indicator,
QListWidget#layerList::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid ${color.checkBorder};
  border-radius: ${size.radiusXs};
  background: ${color.input};
  image: none;
}
QTableWidget#galleryListTable::indicator:hover,
QTableWidget#galleryListTable QCheckBox::indicator:hover,
QCheckBox#galleryCardCheck::indicator:hover,
QCheckBox#galleryDetailSelectionCheck::indicator:hover,
QListWidget#layerList::indicator:hover {
  border-color: ${color.focus};
}
QTableWidget#galleryListTable::indicator:checked,
QTableWidget#galleryListTable QCheckBox::indicator:checked,
QCheckBox#galleryCardCheck::indicator:checked,
QCheckBox#galleryDetailSelectionCheck::indicator:checked,
QListWidget#layerList::indicator:checked {
  background: ${color.accent};
  border-color: ${color.focus};
  image: url(../images/controls/check.svg);
}
QTableWidget#galleryListTable::indicator:indeterminate,
QTableWidget#galleryListTable QCheckBox::indicator:indeterminate,
QCheckBox#galleryCardCheck::indicator:indeterminate,
QCheckBox#galleryDetailSelectionCheck::indicator:indeterminate,
QListWidget#layerList::indicator:indeterminate {
  background: ${color.accent};
  border-color: ${color.focus};
  image: url(../images/controls/check-partial.svg);
}
QTableWidget#galleryListTable::indicator:disabled,
QTableWidget#galleryListTable QCheckBox::indicator:disabled,
QCheckBox#galleryCardCheck::indicator:disabled,
QCheckBox#galleryDetailSelectionCheck::indicator:disabled,
QListWidget#layerList::indicator:disabled {
  background: ${color.disabledBorder};
  border-color: ${color.checkDisabledBorder};
}

QTableWidget#galleryListTable QHeaderView::section {
  font-weight: ${type.weightLabel};
  background: ${color.surface};
  color: ${color.secondary};
  border: 0;
  border-bottom: 1px solid ${color.border};
  padding: 8px;
  font-size: ${type.small};
}

/* Shared text hierarchy. textRole preserves semantic color/action roles. */
QLabel[textRole="caption"],
QWidget#GalleryDetailPage QLabel[textRole="caption"] {
  color: ${color.secondary};
  font-size: ${type.small};
  font-weight: ${type.weightLabel};
}
QLabel[textRole="value"],
QWidget#GalleryDetailPage QLabel[textRole="value"] {
  font-weight: ${type.weightEmphasis};
}
QLabel[textRole="supporting"],
QWidget#GalleryDetailPage QLabel[textRole="supporting"] {
  font-size: ${type.small};
  font-weight: ${type.weightBody};
}
QLabel[textRole="section"] {
  font-size: ${type.section};
  font-weight: ${type.weightEmphasis};
  color: ${color.text};
}
QLabel[textRole="identifier"],
QPlainTextEdit[textRole="code"],
QTextBrowser[textRole="code"] {
  font-family: "${type.monoFamily}", monospace;
  font-size: ${type.small};
  font-weight: ${type.weightBody};
}
QWidget#GalleryDetailPage QLabel[role="unknown"] {
  color: ${color.unknown};
  font-size: ${type.small};
  font-weight: ${type.weightBody};
}
QLabel[textRole]:disabled,
QWidget#GalleryDetailPage QLabel[textRole]:disabled {
  color: ${color.disabled};
}
QWidget#GalleryDetailPage QLabel[role="galleryOverlay"] {
  font-weight: ${type.weightEmphasis};
}
QWidget#GalleryDetailPage QLabel#galleryFixtureOverlay {
  font-weight: ${type.weightBody};
}
QWidget#GalleryDetailPage QLabel[role="galleryCardCaption"] {
  font-size: ${type.small};
  font-weight: ${type.weightEmphasis};
}

/* Shared section cards replace the old native group-box framing. */
QGroupBox[role="sectionCard"] {
  background: ${color.surface};
  border: 1px solid ${color.sectionBorder};
  border-radius: ${size.panelRadius};
  margin-top: 0;
  padding: 0;
}
QGroupBox[role="sectionCard"]::title { padding: 0; }
QFrame[role="sectionHeader"] {
  background: ${color.sectionHeader};
  border: 0;
  border-bottom: 1px solid ${color.sectionBorder};
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
}
QWidget[role="sectionContents"] {
  background: transparent;
  border: 0;
}
QLabel[textRole="panelHeading"],
QCheckBox[textRole="panelHeading"] {
  color: ${color.text};
  font-size: ${type.small};
  font-weight: ${type.weightEmphasis};
}
QLabel[role="sectionIcon"] { background: transparent; border: 0; padding: 0; }
QLabel[iconKey="refresh"] { image: url(../images/gallery/refresh.svg); }
QLabel[iconKey="detail"] { image: url(../images/gallery/detail.svg); }
QLabel[iconKey="grid"] { image: url(../images/gallery/grid.svg); }
QLabel[iconKey="document"] { image: url(../images/gallery/document.svg); }
QLabel[iconKey="json"] { image: url(../images/gallery/json.svg); }
QLabel[iconKey="calendar"] { image: url(../images/gallery/calendar.svg); }
QLabel[iconKey="server"] { image: url(../images/gallery/server.svg); }
QLabel[iconKey="key-round"] { image: url(../images/gallery/key-round.svg); }
QLabel[iconKey="shield-check"] { image: url(../images/gallery/shield-check.svg); }
QLabel[iconKey="flask-conical"] { image: url(../images/gallery/flask-conical.svg); }
QLabel[iconKey="settings"] { image: url(../images/gallery/settings.svg); }
QLabel[iconKey="cloud"] { image: url(../images/gallery/cloud.svg); }
QLabel[iconKey="send"] { image: url(../images/gallery/send.svg); }
QLabel[iconKey="layers"] { image: url(../images/gallery/layers.svg); }
QLabel[iconKey="list-checks"] { image: url(../images/gallery/list-checks.svg); }
QLabel[iconKey="triangle-alert"] { image: url(../images/gallery/triangle-alert.svg); }
QLabel[iconKey="image"] { image: url(../images/gallery/image.svg); }
QLabel[iconKey="box"] { image: url(../images/gallery/box.svg); }
QLabel[iconKey="repeat"] { image: url(../images/gallery/repeat.svg); }
QLabel[iconKey="compass"] { image: url(../images/gallery/compass.svg); }
QLabel[iconKey="waypoints"] { image: url(../images/gallery/waypoints.svg); }
QLabel[iconKey="ban"] { image: url(../images/gallery/ban.svg); }
QLabel[iconKey="dices"] { image: url(../images/gallery/dices.svg); }
QLabel[iconKey="file-image"] { image: url(../images/gallery/file-image.svg); }
QLabel[iconKey="hard-drive"] { image: url(../images/gallery/hard-drive.svg); }
QLabel[iconKey="weight"] { image: url(../images/gallery/weight.svg); }
QLabel[iconKey="timer"] { image: url(../images/gallery/timer.svg); }
QGroupBox[role="sectionCard"]:disabled,
QGroupBox[role="sectionCard"]:disabled QFrame[role="sectionHeader"] {
  border-color: ${color.disabledBorder};
}
QLabel[textRole="panelHeading"]:disabled,
QCheckBox[textRole="panelHeading"]:disabled { color: ${color.disabled}; }
QWidget#GalleryDetailPage QPlainTextEdit[textRole="reading"] {
  font-weight: ${type.weightLabel};
}
QWidget#GalleryDetailPage QPushButton[role="galleryDisclosure"] {
  font-weight: ${type.weightEmphasis};
}
QListWidget::item {
  background: ${color.itemSurface};
  border-radius: ${size.radiusSm};
  margin: 2px;
}
QTableView::item {
  border-bottom: 1px solid ${color.sectionBorder};
  padding: 5px 7px;
}
QTableView::item:hover { background: ${color.buttonHover}; }

QWidget#GalleryDetailPage QPushButton[role="galleryDisclosure"]:checked:hover { background: ${color.accentHover}; }

QWidget#GalleryDetailPage QPushButton[role="galleryDisclosure"]:checked:pressed { background: ${color.accentPressed}; }

/* Model identity and LoRA facts remain visually distinct from status. */
QWidget#GalleryDetailPage QLabel[role="modelMark"] {
  background: ${color.accent};
  border: 1px solid ${color.accentHover};
  border-radius: ${size.inputRadius};
  padding: 4px;
}
QWidget#GalleryDetailPage QLabel#galleryModelValue {
  font-size: ${type.body};
  font-weight: ${type.weightEmphasis};
}
QFrame[role="loraChip"] {
  background: ${color.input};
  border: 1px solid ${color.sectionBorder};
  border-radius: ${size.inputRadius};
}
QWidget#GalleryDetailPage QLabel[textRole="loraName"] {
  color: ${color.text};
  font-size: ${type.small};
  font-weight: ${type.weightLabel};
}
QWidget#GalleryDetailPage QLabel[statusBadge="true"] {
  color: ${color.unknown};
  background: ${color.surface};
  border-radius: ${size.radiusSm};
  padding: 2px 5px;
  font-size: ${type.small};
  font-weight: ${type.weightBody};
}
QWidget#galleryAdditionalScrollContents QLabel[textRole="value"] {
  font-weight: ${type.weightBody};
  border-bottom: 1px solid ${color.sectionBorder};
  padding-bottom: 3px;
}


/* Phase 8E — one-row Images selection/action toolbar. The Designer layout owns spacing. */
QFrame#gallerySelectionBar {
  background: ${color.toolbar};
  border: 1px solid ${color.selectionBorder};
  border-radius: ${size.panelRadius};
}
QFrame#gallerySelectionBar QLabel {
  color: ${color.text};
  background: transparent;
  border: 0;
}
QFrame#gallerySelectionBar QLabel#gallerySelectedCountLabel {
  background: ${color.selection};
  color: ${color.selectionText};
  border: 1px solid ${color.selectionBorder};
  border-radius: ${size.inputRadius};
  padding: 5px 9px;
  font-weight: ${type.weightEmphasis};
}
QFrame#gallerySelectionBar QLabel#galleryHiddenCountLabel {
  color: ${color.secondary};
  font-size: ${type.small};
}
QFrame#gallerySelectionBar QPushButton {
  min-height: 22px;
  padding: 4px 9px;
  border-radius: ${size.radius};
}
QFrame#gallerySelectionBar QPushButton#galleryExportButton {
  background: ${color.button};
  border-color: ${color.buttonBorder};
  color: ${color.buttonText};
  font-weight: ${type.weightEmphasis};
}
QFrame#gallerySelectionBar QPushButton#galleryExportButton:hover {
  background: ${color.buttonHover};
}
QFrame#gallerySelectionBar QPushButton#galleryExportButton:checked {
  background: ${color.selection};
  border-color: ${color.accent};
  color: ${color.selectionText};
}
QFrame#gallerySelectionBar QPushButton#galleryExportButton:checked:hover {
  background: ${color.selectionHover};
}
QFrame#gallerySelectionBar QPushButton#galleryDeleteButton:enabled {
  background: ${color.button};
  color: ${color.dangerText};
  border: 1px solid ${color.dangerBorder};
}
/* One joined split action. The popup is aligned to the entire control by the menu owner. */
QFrame#gallerySelectionBar QPushButton#galleryDeleteButton {
  padding-left: 10px;
  padding-right: 12px;
}
QPushButton#galleryRemovalMenuButton {
  min-width: 24px;
  max-width: 24px;
  padding-left: 2px;
  padding-right: 2px;
  border-left-width: 0;
}
QPushButton#galleryRemovalMenuButton::menu-indicator { image: none; width: 0px; }
QMenu#imageRemovalMenu {
  background: ${color.surface};
  color: ${color.menuText};
  border: 1px solid ${color.buttonBorder};
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-bottom-left-radius: ${size.radius};
  border-bottom-right-radius: ${size.radius};
  padding: 3px;
}
QMenu#imageRemovalMenu::item {
  min-height: 22px;
  padding: 6px 12px 6px 20px;
  margin: 1px 1px;
  border-radius: ${size.radiusSm};
  background: transparent;
}
QMenu#imageRemovalMenu::item:selected {
  background: ${color.buttonHover};
  color: ${color.buttonText};
}
QMenu#imageRemovalMenu::item:pressed {
  background: ${color.buttonPressed};
}
QMenu#imageRemovalMenu::item:checked {
  background: ${color.selection};
}
QMenu#imageRemovalMenu[permanentSelected="true"]::item:checked {
  color: ${color.dangerText};
  background: ${color.dangerSurface};
}
/* Selection is indicated by the checked row background, not a competing icon column. */
QMenu#imageRemovalMenu::indicator { width: 0px; height: 0px; }
QMenu#imageRemovalMenu::indicator:checked { image: none; }
QFrame#gallerySelectionBar QPushButton#galleryDeleteButton:enabled:hover {
  background: ${color.dangerSurface};
}
QFrame#gallerySelectionBar QPushButton:disabled {
  background: ${color.buttonPressed};
  border-color: ${color.disabledEdge};
  color: ${color.disabled};
}
QCheckBox#galleryCardCheck {
  background: ${color.surface};
  border: 1px solid ${color.buttonBorder};
  border-radius: ${size.radiusSm};
  padding: 4px 4px;
  spacing: 0;
}
QCheckBox#galleryCardCheck:checked {
  background: ${color.selection};
  border-color: ${color.selectionBorder};
}
QFrame[role="galleryCard"][checkedSelection="true"] {
  border-color: ${color.selectionBorder};
  background: ${color.selectionPressed};
}

/* Inline input editor scrim: alpha-blended and mouse-blocking, never used for notices. */
QFrame#inlineEditorScrim {
  background-color: ${color.editorScrim};
  border: none;
}

/* Shared bottom feedback overlay: no reserved space, no Details control. */
QFrame#activityStrip {
  background: transparent;
  border: none;
}
QWidget#activityStatusRow {
  background: ${color.warningSurface};
  border: 1px solid ${color.statusWarningBorder};
  border-radius: ${size.radiusChip};
}
QWidget#activityStatusRow QLabel {
  background: transparent;
  border: none;
  padding: 0;
  color: ${color.warning};
  font-size: ${type.small};
}
QPushButton#activityStatusDismissButton {
  min-width: 0;
  min-height: 0;
  padding: 0;
  background: transparent;
  border: none;
  color: ${color.warning};
}
QFrame#inlineFeedback, QWidget#activityProgressRow {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 ${color.selection}, stop:1 ${color.surface});
  border: 1px solid ${color.selectionBorder};
  border-radius: ${size.radius};
}
/* Non-destructive consent reuses the Auto-refresh ON mint/teal palette.
   Red danger tint remains reserved for Delete/Clear and errors. */
QFrame#inlineFeedback[feedbackState="confirm"] {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 ${color.connectionSurface}, stop:1 ${color.surface});
  border-color: ${color.connectionAccent};
}
QFrame#inlineFeedback[feedbackState="partial"],
QFrame#inlineFeedback[feedbackState="stopped"],
QFrame#inlineFeedback[feedbackState="warning"] {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 ${color.warningSurface}, stop:1 ${color.surface});
  border-color: ${color.statusWarningBorder};
}
QWidget#activityProgressRow[feedbackState="partial"],
QWidget#activityProgressRow[feedbackState="stopped"],
QWidget#activityProgressRow[feedbackState="warning"] {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 ${color.warningSurface}, stop:1 ${color.surface});
  border-color: ${color.statusWarningBorder};
}
QFrame#inlineFeedback[feedbackState="error"], QWidget#activityProgressRow[feedbackState="error"] {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 ${color.dangerSurface}, stop:1 ${color.surface});
  border-color: ${color.dangerBorder};
}
QFrame#inlineFeedback[feedbackState="success"],
QWidget#activityProgressRow[feedbackState="success"] {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 ${color.connectionSurface}, stop:1 ${color.surface});
  border-color: ${color.connectionAccent};
}
QLabel#inlineTitleLabel, QLabel#activityLabel {
  background: transparent;
  color: ${color.title};
  font-weight: ${type.weightEmphasis};
}
QTextBrowser#inlineTextBrowser {
  background: transparent;
  border: none;
  padding: 0;
  color: ${color.secondary};
  font-size: ${type.small};
}
QLabel#activityDetail, QLabel#activityCount {
  background: transparent;
  color: ${color.secondary};
  font-size: ${type.small};
}
QLabel#activityLifetime {
  background: transparent;
  color: ${color.connectionAccent};
  font-size: ${type.small};
  font-weight: ${type.weightEmphasis};
}
QWidget#activityProgressRow[feedbackState="warning"] QLabel#activityLifetime,
QWidget#activityProgressRow[feedbackState="partial"] QLabel#activityLifetime,
QWidget#activityProgressRow[feedbackState="stopped"] QLabel#activityLifetime {
  color: ${color.warning};
}
QLabel#inlineSymbol, QLabel#activitySymbol {
  background: ${color.selection};
  color: ${color.focus};
  border-radius: ${size.radiusChip};
  font-weight: ${type.weightStrong};
}
QWidget#activityProgressRow[feedbackState="success"] QLabel#activitySymbol {
  background: ${color.connectionSurface};
  color: ${color.connectionAccent};
}
QWidget#activityProgressRow[feedbackState="partial"] QLabel#activitySymbol,
QWidget#activityProgressRow[feedbackState="stopped"] QLabel#activitySymbol,
QWidget#activityProgressRow[feedbackState="warning"] QLabel#activitySymbol {
  background: ${color.warningGlyphSurface};
  color: ${color.warning};
}
QLabel#inlineSymbol[feedbackState="confirm"] {
  background: ${color.connectionSurface};
  color: ${color.connectionGlyph};
}
QLabel#inlineSymbol[feedbackState="partial"],
QLabel#inlineSymbol[feedbackState="stopped"],
QLabel#inlineSymbol[feedbackState="warning"] {
  background: ${color.warningGlyphSurface};
  color: ${color.warning};
}
QLabel#inlineSymbol[feedbackState="success"] {
  background: ${color.connectionSurface};
  color: ${color.connectionAccent};
}
QWidget#activityProgressRow[feedbackState="error"] QLabel#activitySymbol,
QLabel#inlineSymbol[feedbackState="error"] {
  background: ${color.dangerSurface};
  color: ${color.dangerText};
}
QProgressBar#activityProgress {
  min-height: 5px;
  max-height: 5px;
  padding: 0;
  border: none;
  border-radius: 2px;
  background: ${color.buttonBorder};
}
QProgressBar#activityProgress::chunk {
  background: ${color.accentHover};
  border-radius: 2px;
}
QProgressBar#activityLifetimeBar {
  min-height: 2px;
  max-height: 2px;
  padding: 0;
  border: none;
  background: transparent;
}
QProgressBar#activityLifetimeBar::chunk {
  background: ${color.connectionAccent};
}
QWidget#activityProgressRow[feedbackState="warning"] QProgressBar#activityLifetimeBar::chunk,
QWidget#activityProgressRow[feedbackState="partial"] QProgressBar#activityLifetimeBar::chunk,
QWidget#activityProgressRow[feedbackState="stopped"] QProgressBar#activityLifetimeBar::chunk {
  background: ${color.warning};
}
QPushButton#activityDismissButton {
  min-width: 22px;
  max-width: 22px;
  padding: 0;
  background: transparent;
  border: none;
  color: ${color.secondary};
}

/* Non-destructive Confirm reuses Auto-refresh ON; Cancel stays neutral in feedback. */
QPushButton[confirmationPending="true"]:enabled,
QPushButton#importPresetsButton[confirmationPending="true"]:enabled,
QPushButton#clearInventoryCacheButton[confirmationPending="true"]:enabled,
QPushButton#clearThumbnailCacheButton[confirmationPending="true"]:enabled,
QPushButton#clearDerivedCacheButton[confirmationPending="true"]:enabled,
QPushButton#clearAllCacheButton[confirmationPending="true"]:enabled,
QPushButton#galleryRegenerateButton[confirmationPending="true"]:enabled,
QPushButton#clearCustomLorasButton[confirmationPending="true"]:enabled,
QPushButton#removeKeyButton[confirmationPending="true"]:enabled,
QPushButton#prepareAssetButton[confirmationPending="true"]:enabled,
QPushButton#clearQueuesButton[confirmationPending="true"]:enabled,
QFrame#gallerySelectionBar QPushButton#galleryDeleteButton[confirmationPending="true"]:enabled {
  background: ${color.connectionSurface};
  color: ${color.connectionGlyph};
  border: 1px solid ${color.connectionAccent};
  font-weight: ${type.weightEmphasis};
}

/* Delete/Clear consent has the owner-selected red treatment. */
QPushButton[confirmationPending="true"][confirmationDanger="true"]:enabled,
QPushButton#clearInventoryCacheButton[confirmationPending="true"][confirmationDanger="true"]:enabled,
QPushButton#clearThumbnailCacheButton[confirmationPending="true"][confirmationDanger="true"]:enabled,
QPushButton#clearDerivedCacheButton[confirmationPending="true"][confirmationDanger="true"]:enabled,
QPushButton#clearAllCacheButton[confirmationPending="true"][confirmationDanger="true"]:enabled,
QPushButton#clearCustomLorasButton[confirmationPending="true"][confirmationDanger="true"]:enabled,
QPushButton#clearQueuesButton[confirmationPending="true"][confirmationDanger="true"]:enabled,
QFrame#gallerySelectionBar QPushButton#galleryDeleteButton[confirmationPending="true"][confirmationDanger="true"]:enabled {
  background: ${color.dangerBorder};
  color: ${color.onAccent};
  border-color: ${color.dangerBorder};
}

/* Shared segmented controls inherit ordinary button typography, sizing and padding. */
QFrame[role="segmented"] {
  background: transparent;
  border: 0;
}
QFrame[role="segmented"] QPushButton {
  border-radius: 0;
}
QFrame[role="segmented"] QPushButton[segmentEdge="first"] {
  border-top-left-radius: ${size.radius};
  border-bottom-left-radius: ${size.radius};
}
QFrame[role="segmented"] QPushButton[segmentEdge="last"] {
  border-top-right-radius: ${size.radius};
  border-bottom-right-radius: ${size.radius};
}
QFrame[role="segmented"] QPushButton:checked:enabled {
  background: ${color.selection};
  border-color: ${color.selectionBorder};
  color: ${color.selectionText};
  font-weight: ${type.weightEmphasis};
}
QFrame[role="segmented"] QPushButton:checked:hover:enabled {
  background: ${color.selectionHover};
}
QFrame[role="segmented"] QPushButton:checked:pressed:enabled {
  background: ${color.selectionPressed};
}
QFrame[role="segmented"] QPushButton:disabled {
  background: ${color.buttonPressed};
  border-color: ${color.disabledEdge};
  color: ${color.disabled};
}

/* Model file access indicator: semantic colors, not evidence of loaded ONNX sessions. */
QPushButton#modelsButton {
  padding-right: 26px;
}
QLabel#modelsBadge {
  min-height: 18px;
  max-height: 18px;
  min-width: 18px;
  max-width: 18px;
  border-radius: 9px;
  border: 1px solid ${color.borderStrong};
  background: ${color.surface};
  color: ${color.secondary};
  font-size: 8pt;
  font-weight: ${type.weightStrong};
  padding: 0;
}
QLabel#modelsBadge[readiness="ok"] {
  background: ${color.success};
  border-color: ${color.success};
  color: ${color.background};
}
QLabel#modelsBadge[readiness="missing"],
QLabel#modelsBadge[readiness="checking"] {
  background: ${color.warning};
  border-color: ${color.warning};
  color: ${color.background};
}
QLabel#modelsBadge[readiness="error"] {
  background: ${color.error};
  border-color: ${color.error};
  color: ${color.background};
}
QLabel#modelsBadge[readiness="unknown"] {
  background: ${color.surface};
  border-color: ${color.borderStrong};
  color: ${color.secondary};
}

/* Option 2a pager: the same fixed-height surface survives normal/fullscreen changes. */
QFrame#galleryPagerBar {
  background: ${color.surface};
  border: 1px solid ${color.sectionBorder};
  border-radius: ${size.panelRadius};
}
QFrame#galleryPagerBar QLabel#galleryPagerRange {
  color: ${color.text};
  font-size: 13px;
}
QFrame#galleryPagerBar QLabel#galleryPagerStatus {
  color: ${color.secondary};
  font-size: 12px;
}
QFrame#galleryPagerBar QScrollArea,
QFrame#galleryPagerBar QWidget#galleryPagerChips {
  background: transparent;
  border: none;
}
QWidget#GalleryDetailPage QPushButton[role="galleryPagerChip"] {
  min-width: 28px;
  min-height: 26px;
  max-height: 26px;
  padding: 0 6px;
  border-radius: ${size.radius};
  font-size: 12px;
  background: ${color.button};
  border: 1px solid ${color.buttonBorder};
  color: ${color.text};
}
QWidget#GalleryDetailPage QPushButton[role="galleryPagerChip"]:checked {
  background: ${color.accent};
  border-color: ${color.accentHover};
  color: ${color.onAccent};
  font-weight: ${type.weightEmphasis};
}
QWidget#GalleryDetailPage QPushButton[role="galleryPagerChip"]:focus {
  border-color: ${color.focus};
}
QWidget#GalleryDetailPage QPushButton[role="galleryPagerChip"]:disabled {
  background: ${color.buttonPressed};
  border-color: ${color.disabledBorder};
  color: ${color.disabled};
}

/* Centered Images loader is displayed only without committed gallery cards. */
QWidget#galleryCanvasLoadingOverlay {
  background: ${color.canvas};
}
QWidget#galleryLoadingCenter,
QWidget#galleryLoadingRingHost {
  background: transparent;
}
QLabel#galleryLoadingLabel {
  color: ${color.secondary};
  font-size: 12px;
}
QLabel#galleryLoadingLabel[state="error"] {
  color: ${color.error};
}
QPushButton#galleryLoadingRetryButton {
  background: ${color.button};
  color: ${color.text};
  border: 1px solid ${color.buttonBorder};
  border-radius: ${size.radius};
}
QPushButton#galleryLoadingRetryButton:hover {
  background: ${color.buttonHover};
  border-color: ${color.buttonBorderHover};
}
QPushButton#galleryLoadingRetryButton:focus {
  border-color: ${color.focus};
}


/* Logs workspace: one shared stylesheet; no per-widget Qt stylesheets. */
#LogsWorkspace { background: ${color.background}; color: ${color.text}; }
/* Logs actions are standard bordered buttons, matching the workspace mockup and QPushButton tokens. */
#LogsWorkspace QToolButton { font-weight: ${type.weightLabel}; background-color: ${color.button}; border: 1px solid ${color.buttonBorder}; border-radius: ${size.radius}; color: ${color.buttonText}; min-height: 22px; padding: ${size.radius} 10px; }
#LogsWorkspace QToolButton:hover { background-color: ${color.buttonHover}; border-color: ${color.buttonBorderHover}; }
#LogsWorkspace QToolButton:pressed { background-color: ${color.buttonPressed}; }
#logsNotice { background: ${color.logNoticeSurface}; color: ${color.warning}; border: 1px solid ${color.statusWarningBorder}; border-radius: ${size.radius}; padding: 6px; }
#logsTable { background: ${color.surface}; alternate-background-color: ${color.itemSurface}; border: 1px solid ${color.sectionBorder}; gridline-color: ${color.sectionBorder}; selection-background-color: ${color.selection}; selection-color: ${color.selectionText}; }
#logsTable::item:hover { background: ${color.logRowHover}; }
#logsTable QHeaderView::section { background: ${color.sectionHeader}; color: ${color.text}; padding: 5px; border: 0px; border-right: 1px solid ${color.sectionBorder}; }
#logsDetail { background: ${color.surface}; border-top: 1px solid ${color.sectionBorder}; }
#logsDetailText { background: ${color.logCodeSurface}; color: ${color.text}; font-family: "${type.monoFamily}"; }
#logsCloseButton { color: ${color.dangerText}; background-color: ${color.dangerSurface}; border-color: ${color.dangerBorder}; font-size: 18px; padding: 0px; min-width: 32px; max-width: 32px; }
#logsCloseButton:hover { background-color: ${color.dangerSurface}; border-color: ${color.error}; }
#logsStatusButton:checked { background: ${color.selection}; border: 1px solid ${color.selectionBorder}; border-radius: 3px; }
#logsFollowButton:checked { background-color: ${color.accent}; border-color: ${color.accentEdge}; color: ${color.onAccent}; }
#logsFollowButton:checked:hover { background-color: ${color.accentHover}; }
#logsRefreshButton[pending="true"] { border-color: ${color.accent}; }
#logsCounter { color: ${color.text}; }
#logsEmpty { background: ${color.surface}; color: ${color.secondary}; border: 1px solid ${color.sectionBorder}; border-radius: ${size.radius}; padding: 24px; }
#logsDetailTitle { font-weight: ${type.weightEmphasis}; }
/* Queues composer: removable value chips of one plan dimension. */
QPushButton[role="valueChip"] {
  background-color: ${color.selection};
  border: 1px solid ${color.selectionBorder};
  border-radius: ${size.inputRadius};
  color: ${color.badgeText};
  font-size: ${type.small};
  font-weight: ${type.weightEmphasis};
  min-height: 0;
  padding: 2px 8px;
}
ValueChips[invalid="true"] QPushButton[role="valueChip"],
ValueChips[invalid="true"] QPushButton#valueChipsAddButton {
  border-color: ${color.error};
}

/* Queues items table: painted cells (queue_item_delegate.py); the row surface, hover and selection stay shared. */
QTableView#queueItemsView { gridline-color: transparent; }
QTableView#queueItemsView::item { padding: 0 7px; border-bottom: 1px solid ${color.sectionBorder}; }
QTableView#queueItemsView::item:hover { background: ${color.buttonHover}; }
QTableView#queueItemsView::item:selected { background: ${color.selection}; color: ${color.selectionText}; }
QTableView#queueItemsView QHeaderView::section { background: ${color.sectionHeader}; color: ${color.secondary}; padding: 5px 7px; border: 0; border-bottom: 1px solid ${color.sectionBorder}; }
