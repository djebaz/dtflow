/* DTFlow dark Windows theme.
 * The palette and compact rhythm are adapted from the local Splitvids project;
 * selectors are DTFlow-specific and presentation state is expressed through
 * object names and dynamic properties rather than inline styles.
 */

QMainWindow,
QDialog,
QWidget {
  background-color: #1f1f1f;
  color: #e6e6e6;
  font-family: "Segoe UI", sans-serif;
  font-size: 10pt;
}

QToolTip {
  background-color: #2b2b2b;
  color: #f2f2f2;
  border: 1px solid #4a4a4a;
  padding: 5px;
}

QLabel {
  background: transparent;
}

QFrame#headerFrame,
QFrame#contextRail,
QFrame#workspaceFrame,
QFrame#inspectorPanel,
QFrame#generationContextPanel,
QFrame#generationWorkspace,
QFrame#generationInspector,
QFrame#queueContextPanel,
QFrame#queueWorkspace,
QFrame#queueInspector {
  background-color: #252525;
  border: 1px solid #333333;
  border-radius: 8px;
}

QFrame#headerFrame {
  background-color: #232323;
  border-color: #303030;
}

QFrame#productMark {
  background-color: #0068b8;
  border: 1px solid #1085dd;
  border-radius: 8px;
}

QLabel#productMarkLabel {
  background: transparent;
  color: #ffffff;
  font-size: 15pt;
  font-weight: 700;
}

QLabel#productTitleLabel,
QLabel#workspaceTitleLabel,
QLabel#pageTitleLabel {
  background: transparent;
  color: #f2f2f2;
  font-size: 17pt;
  font-weight: 650;
}

QLabel#productSubtitleLabel,
QLabel#workspaceSubtitleLabel,
QLabel#pageSubtitleLabel,
QLabel#statusHintLabel,
QLabel#credentialStatusLabel,
QLabel[role="secondary"] {
  background: transparent;
  color: #a0a0a0;
}

QLabel:disabled,
QLabel[role="secondary"]:disabled {
  color: #777777;
}

QLabel#eyebrowLabel,
QLabel#workspaceEyebrowLabel,
QLabel#inspectorEyebrowLabel,
QLabel[role="eyebrow"] {
  background: transparent;
  color: #8fbde3;
  font-size: 8pt;
  font-weight: 700;
}

QLabel[role="badge"] {
  background-color: #173852;
  border: 1px solid #285d84;
  border-radius: 8px;
  color: #b9dcf7;
  font-size: 8pt;
  font-weight: 700;
  padding: 5px 9px;
}

QGroupBox {
  background-color: #232323;
  border: 1px solid #373737;
  border-radius: 7px;
  margin-top: 12px;
  padding-top: 8px;
  font-weight: 600;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 5px;
  color: #dddddd;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QTextBrowser,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QListWidget,
QTreeWidget,
QTableView {
  background-color: #1e1e1e;
  border: 1px solid #3a3a3a;
  border-radius: 5px;
  color: #eaeaea;
  selection-background-color: #173852;
  selection-color: #d5ecff;
  alternate-background-color: #242424;
  padding: 5px 7px;
}

/* Single-line inputs keep a readable height when a page is short; the page scrolls instead of crushing them. */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
  min-height: 22px;
}

QScrollArea[role="pageScroll"],
QWidget[role="pageScrollContents"] {
  background: transparent;
  border: 0;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QListWidget:focus,
QTableView:focus {
  border-color: #0078d4;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
  background-color: #252525;
  border-color: #303030;
  color: #777777;
}

QComboBox::drop-down {
  border: 0;
  width: 22px;
}

QPushButton {
  background-color: #2d2d2d;
  border: 1px solid #424242;
  border-radius: 6px;
  color: #eeeeee;
  min-height: 22px;
  padding: 6px 10px;
}

QPushButton:hover {
  background-color: #353535;
  border-color: #5a5a5a;
}

QPushButton[role="navigation"] {
  background-color: transparent;
  border-color: transparent;
  color: #a0a0a0;
  min-width: 84px;
  padding: 6px 12px;
}

QPushButton[role="navigation"]:hover {
  background-color: #2d2d2d;
  border-color: #3a3a3a;
  color: #eeeeee;
}

QPushButton[role="navigation"]:checked {
  background-color: #173852;
  border-color: #285d84;
  color: #d5ecff;
  font-weight: 600;
}

QPushButton:pressed {
  background-color: #292929;
  border-color: #4a4a4a;
}

QPushButton:disabled {
  background-color: #292929;
  border-color: #2f2f2f;
  color: #777777;
}

QPushButton#checkButton,
QPushButton#generateButton,
QPushButton#createQueueButton,
QPushButton[role="primary"] {
  background-color: #0068b8;
  border-color: #0068b8;
  color: #ffffff;
  font-weight: 600;
}

QPushButton#checkButton:hover,
QPushButton#generateButton:hover,
QPushButton#createQueueButton:hover,
QPushButton[role="primary"]:hover {
  background-color: #0078d4;
  border-color: #1085dd;
}

QPushButton#removeKeyButton,
QPushButton#cancelQueueButton,
QPushButton[role="danger"] {
  color: #ff9d97;
}

QPushButton#removeKeyButton:hover,
QPushButton#cancelQueueButton:hover,
QPushButton[role="danger"]:hover {
  background-color: #432323;
  border-color: #c62828;
  color: #ffffff;
}

QPushButton#removeKeyButton:disabled,
QPushButton#cancelQueueButton:disabled,
QPushButton[role="danger"]:disabled {
  background-color: #292929;
  border-color: #2f2f2f;
  color: #777777;
}

QGroupBox:disabled {
  border-color: #303030;
  color: #777777;
}

QFrame#statusCard,
QFrame#previewHost,
QFrame#queueTableHost,
QFrame#emptyStateCard,
QFrame[role="card"] {
  background-color: #1c1c1c;
  border: 1px solid #353535;
  border-radius: 8px;
}

QLabel#statusGlyphLabel {
  background: transparent;
  color: #8a8a8a;
  font-size: 18pt;
}

QFrame#statusCard[state="ok"] {
  border-color: #2e7d32;
}

QFrame#statusCard[state="warning"] {
  border-color: #9a6700;
}

QFrame#statusCard[state="error"] {
  border-color: #a33a35;
}

QLabel#statusGlyphLabel[state="ok"] {
  color: #78c97c;
}

QLabel#statusGlyphLabel[state="warning"] {
  color: #ffbf59;
}

QLabel#statusGlyphLabel[state="error"] {
  color: #ff8179;
}

QLabel#statusLabel {
  background: transparent;
  color: #d7d7d7;
  font-size: 12pt;
  font-weight: 600;
}

QLabel#statusLabel[state="ok"],
QLabel[state="ok"] {
  color: #78c97c;
}

QLabel#statusLabel[state="warning"],
QLabel[state="warning"] {
  color: #ffbf59;
}

QLabel#statusLabel[state="error"],
QLabel[state="error"] {
  color: #ff8179;
}

QLabel[state="unknown"] {
  color: #b7a4e5;
}

QProgressBar {
  background-color: #2a2a2a;
  border: 1px solid #3a3a3a;
  border-radius: 4px;
  color: #e0e0e0;
  min-height: 12px;
  text-align: center;
}

QProgressBar::chunk {
  background-color: #0068b8;
  border-radius: 3px;
}

QTabWidget::pane {
  border: 1px solid #363636;
  border-radius: 6px;
  top: -1px;
}

QTabBar::tab {
  background-color: #252525;
  border: 1px solid #363636;
  color: #a8a8a8;
  padding: 7px 12px;
}

QTabBar::tab:selected {
  background-color: #2d2d2d;
  border-bottom-color: #2d2d2d;
  color: #ffffff;
}

QHeaderView::section {
  background-color: #2b2b2b;
  border: 0;
  border-bottom: 1px solid #3a3a3a;
  color: #d8d8d8;
  padding: 6px;
}

QSplitter::handle {
  background: transparent;
  width: 8px;
}

QSplitter::handle:hover {
  background: #303030;
}

QMenuBar,
QMenu,
QStatusBar {
  background-color: #1f1f1f;
  color: #dddddd;
}

QMenuBar::item:selected,
QMenu::item:selected {
  background-color: #343434;
}

QScrollBar:vertical {
  background: #1f1f1f;
  border: 0;
  margin: 0;
  width: 12px;
}

QScrollBar::handle:vertical {
  background: #4a4a4a;
  border-radius: 5px;
  min-height: 28px;
  margin: 2px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}

QPlainTextEdit[invalid="true"],
QLineEdit[invalid="true"],
QComboBox[invalid="true"],
QAbstractSpinBox[invalid="true"],
QListWidget[invalid="true"] {
  border: 1px solid #ff8179;
}

QSpinBox[level="elevated"] {
  color: #d9b36a;
}

/* One selection language: the navy of the active navigation button, for lists, tables and item views alike. */
QListWidget::item:selected,
QTableView::item:selected,
QTreeWidget::item:selected {
  background-color: #173852;
  color: #d5ecff;
}

QCheckBox {
  background: transparent;
  spacing: 8px;
}

QCheckBox::indicator,
QGroupBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #6a6a6a;
  border-radius: 3px;
  background-color: #1e1e1e;
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover {
  border-color: #0078d4;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked {
  background-color: #0068b8;
  border-color: #1085dd;
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled {
  border-color: #3a3a3a;
  background-color: #252525;
}
