/* DTFlow dark Windows theme.
 * The palette and compact rhythm are adapted from the local Splitvids project;
 * selectors are DTFlow-specific and presentation state is expressed through
 * object names and dynamic properties rather than inline styles.
 */

QMainWindow,
QDialog,
QWidget {
  background-color: ${color.background};
  color: ${color.text};
  font-family: "Segoe UI", sans-serif;
  font-size: ${type.body};
}

QToolTip {
  background-color: #2b2b2b;
  color: #f2f2f2;
  border: 1px solid #4a4a4a;
  padding: ${size.inputRadius};
}

QLabel {
  background: transparent;
}

QFrame#headerFrame,
QFrame#contextRail,
QFrame#workspaceFrame,
QFrame#inspectorPanel,
QFrame#generationContextPanel,
QFrame#generationWorkspace,
QFrame#generationInspector,
QFrame#queueContextPanel,
QFrame#queueWorkspace,
QFrame#queueInspector {
  background-color: ${color.surface};
  border: 1px solid #333333;
  border-radius: 8px;
}

QFrame#headerFrame {
  background-color: #232323;
  border-color: #303030;
}

QFrame#productMark {
  background-color: transparent;
  border: 0;
  border-radius: 8px;
}

QLabel#productMarkLabel {
  background: transparent;
  color: #ffffff;
  font-size: 15pt;
  font-weight: 700;
}

QLabel#productTitleLabel,
QLabel#workspaceTitleLabel,
QLabel#pageTitleLabel {
  background: transparent;
  color: #f2f2f2;
  font-size: ${type.title};
  font-weight: 650;
}

QLabel#productSubtitleLabel,
QLabel#workspaceSubtitleLabel,
QLabel#pageSubtitleLabel,
QLabel#statusHintLabel,
QLabel#credentialStatusLabel,
QLabel[role="secondary"] {
  background: transparent;
  color: ${color.secondary};
}

QLabel:disabled,
QLabel[role="secondary"]:disabled {
  color: ${color.disabled};
}

QLabel#eyebrowLabel,
QLabel#workspaceEyebrowLabel,
QLabel#inspectorEyebrowLabel,
QLabel[role="eyebrow"] {
  background: transparent;
  color: #8fbde3;
  font-size: 8pt;
  font-weight: 700;
}

QLabel[role="badge"] {
  background-color: ${color.selection};
  border: 1px solid #285d84;
  border-radius: 8px;
  color: #b9dcf7;
  font-size: 8pt;
  font-weight: 700;
  padding: ${size.inputRadius} 9px;
}

QGroupBox {
  background-color: #232323;
  border: 1px solid #373737;
  border-radius: 7px;
  margin-top: 12px;
  padding-top: 8px;
  font-weight: 600;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 ${size.inputRadius};
  color: #dddddd;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QTextBrowser,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QListWidget,
QTreeWidget,
QTableView {
  background-color: ${color.input};
  border: 1px solid ${color.border};
  border-radius: ${size.inputRadius};
  color: #eaeaea;
  selection-background-color: ${color.selection};
  selection-color: ${color.selectionText};
  alternate-background-color: #242424;
  padding: ${size.inputRadius} 7px;
}

/* Single-line inputs keep a readable height when a page is short; the page scrolls instead of crushing them. */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
  min-height: ${size.controlContent};
}

QScrollArea[role="pageScroll"],
QWidget[role="pageScrollContents"] {
  background: transparent;
  border: 0;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QListWidget:focus,
QTableView:focus {
  border-color: ${color.accentHover};
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
  background-color: ${color.surface};
  border-color: #303030;
  color: ${color.disabled};
}

QComboBox::drop-down {
  border: 0;
  width: ${size.controlContent};
}

QPushButton {
  background-color: #2d2d2d;
  border: 1px solid #424242;
  border-radius: ${size.radius};
  color: #eeeeee;
  min-height: ${size.controlContent};
  padding: ${size.radius} 10px;
}

QPushButton:hover {
  background-color: #353535;
  border-color: #5a5a5a;
}

QPushButton[role="navigation"] {
  background-color: transparent;
  border-color: transparent;
  color: ${color.secondary};
  min-width: 84px;
  padding: ${size.radius} 12px;
}

QPushButton[role="navigation"]:hover {
  background-color: #2d2d2d;
  border-color: ${color.border};
  color: #eeeeee;
}

QPushButton[role="navigation"]:checked {
  background-color: ${color.selection};
  border-color: #285d84;
  color: ${color.selectionText};
  font-weight: 600;
}

QPushButton:pressed {
  background-color: #292929;
  border-color: #4a4a4a;
}

QPushButton:disabled {
  background-color: #292929;
  border-color: #2f2f2f;
  color: ${color.disabled};
}

QPushButton#checkButton,
QPushButton#generateButton,
QPushButton#createQueueButton,
QPushButton[role="primary"] {
  background-color: ${color.accent};
  border-color: ${color.accent};
  color: #ffffff;
  font-weight: 600;
}

QPushButton#checkButton:hover,
QPushButton#generateButton:hover,
QPushButton#createQueueButton:hover,
QPushButton[role="primary"]:hover {
  background-color: ${color.accentHover};
  border-color: #1085dd;
}

QPushButton#removeKeyButton,
QPushButton#cancelQueueButton,
QPushButton[role="danger"] {
  color: #ff9d97;
}

QPushButton#removeKeyButton:hover,
QPushButton#cancelQueueButton:hover,
QPushButton[role="danger"]:hover {
  background-color: #432323;
  border-color: #c62828;
  color: #ffffff;
}

QPushButton#removeKeyButton:disabled,
QPushButton#cancelQueueButton:disabled,
QPushButton[role="danger"]:disabled {
  background-color: #292929;
  border-color: #2f2f2f;
  color: ${color.disabled};
}

QGroupBox:disabled {
  border-color: #303030;
  color: ${color.disabled};
}

QFrame#statusCard,
QFrame#previewHost,
QFrame#queueTableHost,
QFrame#emptyStateCard,
QFrame[role="card"] {
  background-color: #1c1c1c;
  border: 1px solid #353535;
  border-radius: 8px;
}

QLabel#statusGlyphLabel {
  background: transparent;
  color: #8a8a8a;
  font-size: 18pt;
}

QFrame#statusCard[state="ok"] {
  border-color: #2e7d32;
}

QFrame#statusCard[state="warning"] {
  border-color: #9a6700;
}

QFrame#statusCard[state="error"] {
  border-color: #a33a35;
}

QLabel#statusGlyphLabel[state="ok"] {
  color: ${color.success};
}

QLabel#statusGlyphLabel[state="warning"] {
  color: ${color.warning};
}

QLabel#statusGlyphLabel[state="error"] {
  color: ${color.error};
}

QLabel#statusLabel {
  background: transparent;
  color: #d7d7d7;
  font-size: 12pt;
  font-weight: 600;
}

QLabel#statusLabel[state="ok"],
QLabel[state="ok"] {
  color: ${color.success};
}

QLabel#statusLabel[state="warning"],
QLabel[state="warning"] {
  color: ${color.warning};
}

QLabel#statusLabel[state="error"],
QLabel[state="error"] {
  color: ${color.error};
}

QLabel[state="unknown"] {
  color: ${color.unknown};
}

QProgressBar {
  background-color: #2a2a2a;
  border: 1px solid ${color.border};
  border-radius: 4px;
  color: #e0e0e0;
  min-height: 12px;
  text-align: center;
}

QProgressBar::chunk {
  background-color: ${color.accent};
  border-radius: 3px;
}

QTabWidget::pane {
  border: 1px solid #363636;
  border-radius: ${size.radius};
  top: -1px;
}

QTabBar::tab {
  background-color: ${color.surface};
  border: 1px solid #363636;
  color: #a8a8a8;
  padding: 7px 12px;
}

QTabBar::tab:selected {
  background-color: #2d2d2d;
  border-bottom-color: #2d2d2d;
  color: #ffffff;
}

QHeaderView::section {
  background-color: #2b2b2b;
  border: 0;
  border-bottom: 1px solid ${color.border};
  color: #d8d8d8;
  padding: ${size.radius};
}

QSplitter::handle {
  background: transparent;
  width: 8px;
}

QSplitter::handle:hover {
  background: #303030;
}

QMenuBar,
QMenu,
QStatusBar {
  background-color: ${color.background};
  color: #dddddd;
}

QMenuBar::item:selected,
QMenu::item:selected {
  background-color: #343434;
}

QScrollBar:vertical {
  background: ${color.background};
  border: 0;
  margin: 0;
  width: 12px;
}

QScrollBar::handle:vertical {
  background: #4a4a4a;
  border-radius: ${size.inputRadius};
  min-height: 28px;
  margin: 2px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}

QPlainTextEdit[invalid="true"],
QLineEdit[invalid="true"],
QComboBox[invalid="true"],
QAbstractSpinBox[invalid="true"],
QListWidget[invalid="true"] {
  border: 1px solid ${color.error};
}

QSpinBox[level="elevated"] {
  color: #d9b36a;
}

/* One selection language: the navy of the active navigation button, for lists, tables and item views alike. */
QListWidget::item:selected,
QTableView::item:selected,
QTreeWidget::item:selected {
  background-color: ${color.selection};
  color: ${color.selectionText};
}

QCheckBox {
  background: transparent;
  spacing: 8px;
}

QCheckBox::indicator,
QGroupBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #6a6a6a;
  border-radius: 3px;
  background-color: ${color.input};
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover {
  border-color: ${color.accentHover};
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked {
  background-color: ${color.accent};
  border-color: #1085dd;
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled {
  border-color: ${color.border};
  background-color: ${color.surface};
}


/* Workspace states: keep the shared tokens authoritative; no per-widget inline QSS. */
QFrame#generationWorkspace, QFrame#brandFrame, QWidget#generationLeftRail,
QWidget#generationRightRail, QWidget#leftRail, QWidget#rightRail, QWidget#centerRail, QWidget#WorkspaceShell, QWidget#generationBrandSlot, QWidget#generationNavigationSlot {
  background: transparent; border: 0;
}
QFrame#previewHost, ImagePreview { background: ${color.canvas}; border: 1px solid #353535; }
QFrame#previewToolbar, QFrame#previewFileToolbar {
  background: #242424; border: 1px solid #424242; border-radius: ${size.radius};
}
QFrame#previewToolbar QPushButton, QFrame#previewFileToolbar QPushButton {
  padding: 4px 7px; min-height: 20px;
}
QLabel#previewDesignation {
  color: ${color.text}; background: #242424; border-radius: 4px; padding: 4px 7px;
  font-size: ${type.small};
}
QPushButton#previewSampleButton {
  background: #24415b; color: #eaf5ff; border: 1px solid #3c729d;
  border-radius: ${size.radius}; padding: 6px 14px; min-height: 24px;
}
QPushButton#previewSampleButton:hover { background: #315a7e; border-color: ${color.focus}; }
QPushButton#previewSampleButton:pressed { background: #19364e; }
QPushButton#previewSampleButton:focus { border-color: ${color.focus}; }
QPushButton:focus, QPushButton[role="navigation"]:focus, QCheckBox:focus {
  border: 1px solid ${color.focus};
}
QPushButton:checked { background: ${color.selection}; border-color: #285d84; color: ${color.selectionText}; }
QPushButton#generateButton:pressed, QPushButton#checkButton:pressed,
QPushButton#createQueueButton:pressed, QPushButton[role="primary"]:pressed {
  background: ${color.accentPressed}; border-color: ${color.focus};
}
QPushButton#generateButton:disabled, QPushButton#checkButton:disabled,
QPushButton#createQueueButton:disabled, QPushButton[role="primary"]:disabled {
  background: #292929; border-color: #303030; color: ${color.disabled};
}
QPushButton[role="navigation"] { min-width: 0; padding: 6px 8px; }
QPushButton[role="navigation"]:checked:hover { background: #204c6e; color: ${color.selectionText}; }
QPushButton[role="navigation"]:checked:pressed { background: #122e44; }
QLineEdit, QPlainTextEdit, QComboBox { placeholder-text-color: ${color.placeholder}; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #606060; }
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: ${color.focus}; }
QPlainTextEdit:disabled, QTextBrowser:disabled, QListWidget:disabled {
  background: ${color.surface}; border-color: #303030; color: ${color.disabled};
}
QListWidget::item { padding: 5px 6px; }
QListWidget::item:hover { background: #303030; }
QListWidget::item:selected { background: ${color.selection}; color: ${color.selectionText}; }
QCheckBox { spacing: 7px; background: transparent; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #777777; border-radius: 3px; background: ${color.input}; }
QCheckBox::indicator:hover { border-color: ${color.focus}; }
QCheckBox::indicator:checked { background: ${color.accent}; border-color: ${color.focus}; }
QCheckBox::indicator:disabled { background: #303030; border-color: #414141; }
QCheckBox:disabled { color: ${color.disabled}; }
QSlider::groove:horizontal { height: 4px; background: #505050; border-radius: 2px; }
QSlider::sub-page:horizontal { background: ${color.accentHover}; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -4px 0; background: #e6e6e6; border: 1px solid #909090; border-radius: 3px; }
QSlider::handle:horizontal:hover, QSlider::handle:horizontal:focus { background: ${color.focus}; }
QSlider::handle:horizontal:pressed { background: ${color.accentHover}; }
QSlider::handle:horizontal:disabled { background: #555555; border-color: #555555; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #707070; }
QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed { background: #909090; }
ImagePreview:focus { border-color: ${color.focus}; }
QScrollBar:horizontal { background: ${color.background}; border: 0; margin: 0; height: ${size.scrollbar}; }
QScrollBar::handle:horizontal { background: #4a4a4a; border-radius: 5px; min-width: 28px; margin: 2px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; border: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
